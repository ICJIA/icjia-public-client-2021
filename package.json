{
  "name": "icjia-public-client",
  "version": "1.3.40",
  "private": true,
  "description": "ICJIA Public Website (2024)",
  "author": {
    "name": "Illinois Criminal Justice Information Authority",
    "email": "cja.info@illinois.gov"
  },
  "engines": {
    "node": ">=16.x",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "serve": "npm run copy:fuse && kill-port 8080 && npm run scripts && NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "npm run copy:fuse && npm run generate:images && npm run scripts && NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "copy:fuse": "node -e \"require('fs').copyFileSync('node_modules/fuse.js/dist/fuse.basic.min.js','public/fuse.min.js')\"",
    "lint": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service lint",
    "generate:feeds": "node ./generators/generateRSSNews.mjs && node ./generators/generateRSSFunding.mjs && node ./generators/generateRSSMeetings.mjs && node ./generators/generateRSSEmployment.mjs",
    "generate:images": "node ./generators/generateImagesHub",
    "generate:schema": "get-graphql-schema https://agency.icjia-api.cloud/graphql -j > schema.json",
    "generate:search": "node ./generators/generateIndexHub && node ./generators/generateIndexUnits && node ./generators/generateIndexGrants && node ./generators/generateIndexPages && node ./generators/generateIndexMeetings && node ./generators/generateIndexEvents && node ./generators/generateIndexPosts && node ./generators/generateIndexJobs && node ./generators/generateIndexBiographies &&  node ./generators/generateIndexPublications && node ./generators/searchIndexAndSitemap",
    "postbuild": "node ./generators/generateBuildInfo",
    "test": "npx playwright test",
    "tests": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service test:unit --recursive --timeout 10000 --require ./tests/unit/setup.js",
    "tests:watch": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service test:unit --recursive --timeout 10000 --require ./tests/unit/setup.js --watch",
    "audit": "node scripts/a11y-audit-by-type.js",
    "check-links": "node scripts/check-broken-links.js",
    "release": "release-it",
    "scripts": "npm run generate:schema && npm run generate:search && npm run generate:feeds"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@mdi/js": "^6.1.95",
    "aos": "^3.0.0-beta.6",
    "arrford": "^2.0.1",
    "auto-changelog": "^2.3.0",
    "axios": "^0.21.4",
    "cheerio": "1.0.0-rc.10",
    "concurrently": "^6.3.0",
    "core-js": "^3.18.0",
    "date-fns": "^2.24.0",
    "dompurify": "^2.3.3",
    "dotenv": "^10.0.0",
    "eslint-plugin-graphql": "^4.0.0",
    "feed": "^4.2.2",
    "fs-extra": "^10.0.0",
    "fuse.js": "^6.4.6",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^15.6.0",
    "graphql-request": "^3.5.0",
    "jsonfile": "^6.1.0",
    "kill-port": "^1.6.1",
    "lodash": "^4.17.21",
    "markdown-it": "^12.2.0",
    "markdown-it-anchor": "^8.3.1",
    "markdown-it-attrs": "^4.0.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-implicit-figures": "^0.10.0",
    "markdown-it-link-attributes": "^3.0.0",
    "markdown-it-multimd-table": "^4.1.0",
    "markdown-it-named-headers": "0.0.4",
    "markdown-link": "^0.1.1",
    "markdown-toc": "^1.2.0",
    "material-design-icons-iconfont": "^6.1.0",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "nanoid": "^3.1.25",
    "regenerator-runtime": "^0.13.9",
    "sitemap": "^7.0.0",
    "slug": "^5.1.0",
    "thumbor-url-builder": "^0.1.1",
    "vue": "^2.6.14",
    "vue-apollo": "^3.0.8",
    "vue-gtag": "^1.16.1",
    "vue-meta": "^2.4.0",
    "vue-router": "^3.5.2",
    "vue-tweet-embed": "^2.4.0",
    "vuelidate": "^0.7.7",
    "vuetify": "2.5.12",
    "vuex": "^3.6.2",
    "vuex-persistedstate": "^4.1.0",
    "xml": "^1.0.1"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.10.2",
    "@playwright/test": "^1.58.2",
    "@release-it/bumper": "^3.0.1",
    "@vue/cli-plugin-babel": "~4.5.13",
    "@vue/cli-plugin-eslint": "~4.5.13",
    "@vue/cli-plugin-router": "~4.5.13",
    "@vue/cli-plugin-unit-mocha": "^5.0.9",
    "@vue/cli-plugin-vuex": "~4.5.13",
    "@vue/cli-service": "~4.5.13",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/test-utils": "^1.3.6",
    "babel-eslint": "^10.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "chai": "^4.5.0",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^7.18.0",
    "graphql-tag": "^2.12.5",
    "prettier": "^2.4.0",
    "puppeteer": "^24.23.0",
    "release-it": "^14.11.5",
    "sass": "~1.32.13",
    "sass-loader": "10.1.1",
    "vue-cli-plugin-apollo": "^0.22.2",
    "vue-cli-plugin-compression": "^1.1.5",
    "vue-cli-plugin-lodash": "^0.1.4",
    "vue-cli-plugin-moment": "^0.1.1",
    "vue-cli-plugin-vuetify": "^2.4.2",
    "vue-template-compiler": "^2.6.14",
    "vuetify-loader": "^1.7.3"
  },
  "auto-changelog": {
    "commitLimit": false,
    "unreleased": true,
    "issueUrl": "https://app.clickup.com/t/{id}",
    "replaceText": {
      "^ #(.{6})\\s": "[$1](https://app.clickup.com/t/$1) - "
    },
    "browserslist": [
      "last 3 years"
    ],
    "includeBranch": [
      "develop",
      "master"
    ]
  },
  "homepage": "https://icjia.illinois.gov/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ICJIA/icjia-public-2021"
  }
}

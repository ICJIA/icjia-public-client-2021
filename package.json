{
  "name": "icjia-public-2021",
  "version": "0.1.0",
  "private": true,
  "description": "ICJIA Public Website (2021)",
  "author": {
    "name": "Illinois Criminal Justice Information Authority / Christopher Schweda (Web Developer)",
    "email": "cja.info@illinois.gov"
  },
  "homepage": "https://icjia.illinois.gov/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ICJIA/icjia-public-2021"
  },
  "scripts": {
    "serve": "npm run scripts && vue-cli-service serve",
    "build": "npm run generate:images && npm run scripts && vue-cli-service build",
    "lint": "vue-cli-service lint",
    "scripts": "npm run generate:schema && npm run generate:search && npm run generate:feeds",
    "generate:search": "node ./generators/generateIndexHub && node ./generators/generateIndexUnits && node ./generators/generateIndexGrants && node ./generators/generateIndexPages && node ./generators/generateIndexMeetings && node ./generators/generateIndexEvents && node ./generators/generateIndexPosts && node ./generators/generateIndexJobs && node ./generators/generateIndexBiographies &&  node ./generators/generateIndexPublications && node ./generators/searchIndexAndSitemap",
    "generate:images": "node ./generators/generateImagesHub",
    "generate:feeds": "node ./generators/generateRSSNews.mjs && node ./generators/generateRSSFunding.mjs && node ./generators/generateRSSMeetings.mjs",
    "generate:schema": "get-graphql-schema https://agency.icjia-api.cloud/graphql -j > schema.json",
    "postbuild": "node ./generators/generateBuildInfo",
    "build:lambda": "netlify-lambda build ./src/lambda",
    "start:lambda": "netlify-lambda serve ./src/lambda"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "@mdi/js": "^5.9.55",
    "aos": "^3.0.0-beta.6",
    "arrford": "^2.0.1",
    "auto-changelog": "^2.3.0",
    "axios": "^0.21.1",
    "cheerio": "^1.0.0-rc.10",
    "core-js": "^3.15.2",
    "date-fns": "^2.23.0",
    "dompurify": "^2.3.1",
    "dotenv": "^10.0.0",
    "eslint-plugin-graphql": "^4.0.0",
    "feed": "^4.2.2",
    "fs-extra": "^7.0.1",
    "fuse.js": "^6.4.6",
    "get-graphql-schema": "^2.1.2",
    "graphql": "^15.5.1",
    "graphql-request": "^3.5.0",
    "jsonfile": "^6.1.0",
    "lodash": "^4.17.21",
    "markdown-it": "^12.2.0",
    "markdown-it-anchor": "^8.1.2",
    "markdown-it-attrs": "^4.0.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-implicit-figures": "^0.10.0",
    "markdown-it-link-attributes": "^3.0.0",
    "markdown-it-multimd-table": "^4.1.0",
    "markdown-it-named-headers": "0.0.4",
    "markdown-link": "^0.1.1",
    "markdown-toc": "^1.2.0",
    "material-design-icons-iconfont": "^6.1.0",
    "moment": "^2.29.1",
    "moment-timezone": "^0.5.33",
    "nanoid": "^3.1.25",
    "netlify-lambda": "^2.0.14",
    "nprogress": "^0.2.0",
    "regenerator-runtime": "^0.13.9",
    "researchhub-lib": "github:icjia/researchhub-lib#v1.1.6",
    "sitemap": "^7.0.0",
    "slug": "^5.1.0",
    "thumbor-url-builder": "^0.1.1",
    "vue": "^2.6.14",
    "vue-apollo": "^3.0.7",
    "vue-meta": "^2.4.0",
    "vue-router": "^3.5.2",
    "vue-tweet-embed": "^2.4.0",
    "vuetify": "^2.5.8",
    "vuex": "^3.6.2",
    "vuex-persistedstate": "^4.0.0-beta.3",
    "xml": "^1.0.1"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.13",
    "@vue/cli-plugin-eslint": "~4.5.13",
    "@vue/cli-plugin-router": "~4.5.13",
    "@vue/cli-plugin-vuex": "~4.5.13",
    "@vue/cli-service": "~4.5.13",
    "@vue/eslint-config-prettier": "^6.0.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-vue": "^7.16.0",
    "graphql-tag": "^2.12.5",
    "node-sass": "6.0.0",
    "prettier": "^2.3.2",
    "sass": "~1.32.13",
    "sass-loader": "10.1.1",
    "vue-cli-plugin-apollo": "^0.22.2",
    "vue-cli-plugin-moment": "^0.1.1",
    "vue-cli-plugin-vuetify": "^2.4.2",
    "vue-template-compiler": "^2.6.14",
    "vuetify-loader": "^1.7.2"
  },
  "auto-changelog": {
    "commitLimit": false,
    "unreleased": true,
    "issueUrl": "https://app.clickup.com/t/{id}",
    "replaceText": {
      "[Ff]eat:": "",
      "[Ff]ix:": "",
      "[Bb]reak:": "",
      "^ #(.{6})\\s": "[$1](https://app.clickup.com/t/$1) - "
    },
    "browserslist": [
      "last 3 years"
    ],
    "includeBranch": [
      "develop",
      "master"
    ]
  }
}
{
  "name": "icjia-public-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ICJIA public website — Astro 6 + Tailwind 4 + Alpine (live-data SSR migration)",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/generate-hub-images.mjs && node scripts/generate-search-index.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "hub-images": "node scripts/generate-hub-images.mjs",
    "search-index": "node scripts/generate-search-index.mjs",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "vr": "node scripts/vr/run.mjs",
    "health": "node scripts/route-health.mjs",
    "health:full": "node scripts/route-health.mjs --full",
    "warm": "node scripts/route-health.mjs --warm",
    "warm:full": "node scripts/route-health.mjs --warm --full",
    "og-image": "node scripts/generate-og-image.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.5.0",
    "@astrojs/netlify": "^7.0.11",
    "@astrojs/node": "^11.0.2",
    "@fontsource/lato": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "alpinejs": "^3.15.12",
    "astro": "^6.4.2",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "dompurify": "^3.4.7",
    "jsdom": "^25.0.1",
    "linkedom": "^0.18.12",
    "markdown-it": "^12.2.0",
    "markdown-it-anchor": "^8.3.1",
    "markdown-it-attrs": "^4.0.0",
    "markdown-it-footnote": "^3.0.3",
    "markdown-it-implicit-figures": "^0.10.0",
    "markdown-it-link-attributes": "^3.0.0",
    "markdown-it-multimd-table": "^4.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/alpinejs": "^3.13.11",
    "@types/markdown-it": "^12.2.3",
    "@types/node": "^25.9.1",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}

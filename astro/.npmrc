# Flatten node_modules (npm/yarn-style) instead of pnpm's default symlinked
# layout. Required for Astro SSR on Netlify: the @astrojs/netlify adapter
# externalizes runtime deps (e.g. `cookie`, a transitive Astro dependency) and
# relies on Netlify's function bundler tracing them in node_modules. pnpm's
# default nested .pnpm/ layout has no top-level `node_modules/cookie`, so the
# function crashes at runtime with "Cannot find package 'cookie'". Hoisting
# fixes the whole class of transitive-dep resolution failures in the SSR
# function. (sharp/esbuild build-script approval is handled separately via
# pnpm.onlyBuiltDependencies in package.json.)
node-linker=hoisted

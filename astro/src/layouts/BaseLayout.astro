---
// Self-hosted fonts (same families/weights as the legacy Google Fonts:
// Lato 300/400/700/900, Oswald 400/500/600/700) — identical glyph metrics.
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/900.css';
import '@fontsource/oswald/400.css';
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource/oswald/700.css';
import '../styles/global.css';
import { SEO } from 'astro-seo';
import { siteConfig, buildTitle, truncateDescription, serializeJsonLd } from '../lib/seo';
import SiteHeader from '../components/SiteHeader.astro';
import SiteContextBar from '../components/SiteContextBar.astro';
import SiteDisclaimer from '../components/SiteDisclaimer.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TranslateModal from '../components/TranslateModal.astro';

interface Props {
  title?: string;
  description?: string;
  /** 3rd breadcrumb segment in the context bar (page/item title). */
  contextTitle?: string;
  /** Canonical URL. Defaults to the current page's own URL; alias routes
   *  (e.g. /news/events/ → /events/) pass the canonical target so duplicate
   *  content consolidates to one URL. */
  canonical?: string;
  /** Per-page OG image override (defaults to the site OG image). */
  ogImage?: string;
  /** JSON-LD structured data — one object or several. Built via the seo.ts
   *  builders (home WebSite+Org, NewsArticle, Event, JobPosting, Person, …).
   *  Each is emitted as its own <script type="application/ld+json">. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Keep the page out of the search index (404, error/maintenance pages).
   *  Followable (no nofollow) — links from a 404 should still be crawled. */
  noindex?: boolean;
}
const { title = 'ICJIA', description = '', contextTitle, canonical, ogImage, jsonLd, noindex = false } = Astro.props;
// Production origin (not the branch-deploy host) so canonicals point at the live
// site regardless of which deploy renders them.
const SITE = siteConfig.siteOrigin;
const canonicalHref = canonical
  ? new URL(canonical, SITE).href
  : new URL(Astro.url.pathname, SITE).href;
// Final title/description/og — `title` is a BARE chunk; buildTitle wraps it as
// "ICJIA | <chunk>" (prod convention) and clamps to 60 chars.
const fullTitle = buildTitle(title);
const metaDesc = truncateDescription(description);
// og:image → absolute against the CURRENT deploy origin (branch preview or prod),
// so it always resolves. A per-page `ogImage` may be an absolute URL (e.g. a Strapi
// splash) — new URL() leaves an absolute input untouched and resolves a site-relative
// path (the branded default) against the origin.
const ogImg = new URL(ogImage ?? siteConfig.ogImage, Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {/* astro-seo: title (+ clamp), description, canonical (prod origin, trailing
        slash), Open Graph + Twitter card — values match approved prod. */}
    <SEO
      title={fullTitle}
      description={metaDesc}
      canonical={canonicalHref}
      noindex={noindex}
      openGraph={{
        basic: { title: fullTitle, type: 'website', image: ogImg, url: canonicalHref },
        optional: { description: metaDesc, siteName: siteConfig.siteName },
      }}
      twitter={{ card: 'summary_large_image', title: fullTitle, description: metaDesc, image: ogImg }}
      extend={{
        meta: [{ name: 'google-site-verification', content: siteConfig.googleSiteVerification }],
      }}
    />
    {jsonLd &&
      (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((obj) => (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(obj)} />
      ))}
    {/* Plausible analytics (self-hosted) — ported verbatim from the legacy prod
        snippet. The `file-downloads.outbound-links` script variant tracks
        pageviews + file downloads + outbound link clicks, and exposes
        window.plausible(...) for the custom events the meeting/publication/
        attachment components fire (file_download, "Outbound Link: Click"). The
        queue stub buffers those calls until the deferred script loads. CSP
        allows plausible.icjia.cloud in script-src + connect-src (see _headers). */}
    <script
      is:inline
      defer
      data-domain="icjia.illinois.gov"
      src="https://plausible.icjia.cloud/js/script.file-downloads.outbound-links.js"></script>
    <script is:inline>
      window.plausible =
        window.plausible ||
        function () {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
    </script>
    {/* Loading overlay — critical CSS inlined so it paints with the HTML (no
        render-blocking round-trip). A delayed reveal (0.2s) means fast loads
        never flash it; slow loads / cold lambdas show the branded screen the
        instant the response paints. Hidden on DOMContentLoaded + a failsafe. */}
    <style is:inline>
      #app-loader {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 18px;
        background: #fff;
        opacity: 0;
        animation: ldrise 0s linear 0.2s forwards;
      }
      #app-loader img {
        width: 90px;
        height: auto;
      }
      #app-loader .ld-spin {
        width: 30px;
        height: 30px;
        border: 3px solid #dcdcdc;
        border-top-color: #0a3a60;
        border-radius: 50%;
        animation: ldspin 0.8s linear infinite;
      }
      #app-loader .ld-txt {
        font: 700 13px/1 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #0a3a60;
      }
      @keyframes ldspin {
        to {
          transform: rotate(360deg);
        }
      }
      @keyframes ldrise {
        to {
          opacity: 1;
        }
      }
      html.app-loaded #app-loader {
        animation: none;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      @media (prefers-reduced-motion: reduce) {
        #app-loader .ld-spin {
          animation-duration: 1.6s;
        }
      }
    </style>
    <noscript>
      <style>
        #app-loader {
          display: none;
        }
      </style>
    </noscript>
    <style is:inline>
      /* Top navigation progress bar — shown on the CURRENT page the instant an
         internal link is clicked, so the cold-start/SSR wait for the next page
         is covered by visible motion (the browser stays on this page until the
         next response's first byte). Restores the legacy NProgress behavior. */
      #nav-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 4px;
        width: 0;
        background: #1565c0;
        z-index: 100000;
        opacity: 0;
        transition:
          width 0.2s ease,
          opacity 0.2s ease;
        box-shadow: 0 0 10px rgba(21, 101, 192, 0.65);
      }
      #nav-progress.on {
        opacity: 1;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col">
    <div id="nav-progress" aria-hidden="true"></div>
    <div id="app-loader" role="status" aria-label="Loading">
      <img src="/icjia-logo.png" alt="" width="90" height="70" />
      <div class="ld-spin" aria-hidden="true"></div>
      <div class="ld-txt">Loading</div>
    </div>
    <a class="skiplink" href="#main-content">Skip to main content</a>
    <SiteHeader />
    {/* The CONTENT area fills the first viewport so the disclaimer + footer flow
        BELOW the fold on short pages — mirroring prod's legacy `.page`
        min-height: calc(100vh - chrome). Without it the disclaimer rode up ~455px on
        short pages (e.g. /irb/irb-meetings/, 3 rows). NOTE: `flex-1` here is WRONG —
        it reserves the disclaimer INSIDE the viewport (pulls it up); a min-height on
        the content fills past it. 160px ≈ fixed header (90) + context bar (~70). The
        fixed header is out of flow, so pt-[90px] clears it; main stays flex-1 so the
        footer still sticks on any sub-viewport page. */}
    <main id="main-content" class="flex-1 pt-[90px]">
      <SiteContextBar contextTitle={contextTitle} />
      <div class="min-h-[calc(100vh-160px)]"><slot /></div>
      <SiteDisclaimer />
    </main>
    <SiteFooter />
    <TranslateModal />
    <script is:inline>
      (function () {
        var d = document;
        function done() {
          d.documentElement.classList.add('app-loaded');
          var l = d.getElementById('app-loader');
          if (l) setTimeout(function () { l.remove(); }, 400);
        }
        if (d.readyState === 'loading') d.addEventListener('DOMContentLoaded', done);
        else done();
        setTimeout(done, 10000); // failsafe — never trap content behind the overlay
      })();
    </script>
    <script is:inline>
      /* Navigation progress bar: start on an internal-link click (covers the
         next page's cold-start/SSR wait), creep toward 90% while we wait, then
         the browser swaps in the new document. */
      (function () {
        var bar = document.getElementById('nav-progress');
        if (!bar) return;
        var timer = null;
        function start() {
          if (timer) return; // already navigating
          var p = 8;
          bar.classList.add('on');
          bar.style.width = p + '%';
          timer = setInterval(function () {
            p += (90 - p) * 0.12; // ease toward 90%, never reach it until load
            bar.style.width = p.toFixed(1) + '%';
          }, 200);
        }
        function reset() {
          if (timer) { clearInterval(timer); timer = null; }
          bar.classList.remove('on');
          bar.style.width = '0';
        }
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target && e.target.closest ? e.target.closest('a') : null;
          if (!a) return;
          var href = a.getAttribute('href');
          if (!href || href.charAt(0) === '#') return;
          if (a.target && a.target !== '_self') return;
          if (a.hasAttribute('download')) return;
          var url;
          try { url = new URL(a.href, location.href); } catch (_e) { return; }
          if (url.origin !== location.origin) return; // external → browser handles it
          if (url.pathname === location.pathname && url.search === location.search) return; // same page / hash
          start();
        }, true);
        // bfcache restore (back/forward) → page is shown again, clear any bar.
        window.addEventListener('pageshow', reset);
        window.addEventListener('pagehide', reset);
      })();
    </script>
  </body>
</html>

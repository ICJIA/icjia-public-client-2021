---
// Site footer — port of AppFooter.vue. Navy (#0d4474), centered logo + link
// row + copyright. "Translate Site" is wired to the Google Translate widget in
// Phase 4 (third-party); kept here for link-row parity.
const year = new Date().getFullYear();

const links = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/about/contact/' },
  { label: 'Search', href: '/search/' },
  { label: 'Document Archive', href: 'https://archive.icjia.cloud', external: true },
  { label: 'FOIA', href: '/foia/' },
  { label: 'Language Access Request', href: '/forms/lap-request/' },
  { label: 'Privacy', href: '/about/privacy/' },
  { label: 'Grant Status Request', href: '/forms/grant-status/' },
  {
    label: 'Subscribe to CJ Dispatch',
    href: 'https://visitor.r20.constantcontact.com/manage/optin?v=001MqUcqqvjwLCJXlLMSWbTe3zHHmEQgFeBuHvBcJWTbwgrxFbDSGx4HSUPpI6DJWMUPgbljtLxffqIcGFTgCnr-auak88ybvRxpoJlTMGPtZs%3D',
    external: true,
  },
];
---

<footer class="dark-surface" style="background:#0d4474">
  <div class="mx-auto max-w-5xl px-4 pb-4 pt-6 text-center text-white">
    <a href="/" class="inline-block no-underline">
      <img src="/icjia-logo.png" alt="" width="100" height="70" loading="lazy" decoding="async" class="inline" />
      <span class="sr-only">ICJIA Home</span>
    </a>

    <div class="pb-6" aria-hidden="true"></div>

    <nav aria-label="Footer" class="text-xs font-normal leading-7">
      {
        links.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener noreferrer' : undefined}
              class="!font-normal !text-white"
              style="background:none"
            >
              {l.label}
            </a>
          </>
        ))
      }
      <span aria-hidden="true"> | </span>
      {/* Translate is wired to Google Translate in Phase 4 */}
      <button
        type="button"
        class="cursor-pointer border-0 bg-transparent p-0 font-[inherit] text-[inherit] text-white underline"
        data-translate-trigger
      >
        Translate Site
      </button>
    </nav>

    <div class="mt-3 text-xs font-light text-white">
      <strong>&#169; {year} Illinois Criminal Justice Information Authority</strong>
    </div>
  </div>
</footer>

---
// Generic CMS-page renderer — ports legacy BasePage.vue (src/views/BasePage.vue).
// Reused by About / Units / Hub-overview landing pages (each fetches a CmsPage
// via getPage() and hands it here). Static, fully server-rendered.
//
// Layout (mirrors BasePage.vue, top → bottom):
//   1. Splash (full width) when page.splash.
//   2. Two-col grid (body md:8 + PageToc md:4) WHEN page.showTOC && toc.length,
//      else a single full-width column. The grid is nudged up 15px to match the
//      legacy `v-container style="margin-top:-15px"`.
//        body col: h1 (titleHtml, set:html; suppressed when hideTitle)
//                  → div.markdown-body body (set:html safeBodyHtml)
//                  → tag chips (plain spans) → AttachmentList.
//   3. ContentClickThroughBoxes (full width) when page.clickthrough.
//
// Wraps everything in .markdown-body (legacy root class) inside a centered
// max-width container, matching the sibling detail pages.
//
// PARITY NOTES:
// - `summary` is part of CmsPage / Props but legacy BasePage.vue never renders it
//   in the body, so it is intentionally NOT rendered here (passed through only).
// - `hideUpdated`: legacy set this true ONLY for the `meeting-schedules` slug
//   (to drop AttachmentList's "Last Updated" column). CmsPage carries no slug, so
//   the quirk is exposed as an optional prop the consuming page can set.
import '../styles/github-markdown.css';
import Splash from './Splash.astro';
import PageToc from './PageToc.astro';
import AttachmentList from './AttachmentList.astro';
import ContentClickThroughBoxes from './ContentClickThroughBoxes.astro';
import type { CmsPage } from '../lib/data';

interface Props {
  page: CmsPage;
  /** Legacy `meeting-schedules` quirk: hide AttachmentList's "Last Updated". */
  hideUpdated?: boolean;
}
const { page, hideUpdated = false } = Astro.props;

const showToc = !!page.showTOC && page.toc.length > 0;
---

<div class="markdown-body mx-auto max-w-[1185px] px-3 py-8">
  {/* 1. Splash — FULL WIDTH above the grid (matches prod: splash spans the full
      container, with the H1/body/TOC all starting below it). */}
  <Splash splash={page.splash} />

  {/* 2. Body + optional TOC — prod metrics (1280px): body 790 / TOC 270 / gap 109.
       Flex with a fixed-basis TOC reproduces prod's proportions exactly at desktop
       and degrades to a single column below md. The `.bp-grid` -15px nudge (always
       on, mirroring prod's unconditional `<v-container style="margin-top:-15px">`)
       is applied via the style block below — a raw Tailwind `-mt-[15px]` here is a
       no-op when there's no splash, because then this div is .markdown-body's first
       child and github-markdown's `> :first-child { margin-top:0 !important }` zeros
       it. */}
  <div class:list={['bp-grid', { 'md:flex md:items-start md:gap-[109px]': showToc }]}>
    <div class:list={[{ 'md:min-w-0 md:flex-1': showToc }]}>
      {!page.hideTitle && <h1 set:html={page.titleHtml} />}

      <div set:html={page.safeBodyHtml} />

      {
        page.tags.length > 0 && (
          <div class="mt-6">
            {page.tags.map((tag) => (
              <span class="chip">{tag}</span>
            ))}
          </div>
        )
      }

      <AttachmentList
        items={page.attachments}
        label={page.attachmentLabel}
        hideUpdated={hideUpdated}
      />
    </div>

    {
      showToc && (
        <aside class="mt-8 md:mt-0 md:w-[270px] md:shrink-0">
          <PageToc items={page.toc} />
        </aside>
      )
    }
  </div>

  {/* 3. Full-width "For more information" click-through boxes. */}
  <ContentClickThroughBoxes boxes={page.clickthrough} />
</div>

<style is:global>
  /* No-JS / deep-link fallback: when an in-page anchor is jumped to natively
     (JS off, or a hard load with #hash), offset the target below the fixed 90px
     app bar so the heading isn't hidden under it. The PageToc click handler does
     a smooth, offset scroll when JS is on; this guarantees correct landing either
     way. Scoped to CMS-body headings (the anchor targets). */
  .markdown-body :is(h1, h2, h3, h4)[id] {
    scroll-margin-top: 96px;
  }

  /* Reproduce prod BasePage.vue's always-on `v-container { margin-top: -15px }`
     content nudge. When there's no splash, this grid is .markdown-body's first
     child, so github-markdown's `> :first-child { margin-top: 0 !important }` would
     kill a plain -mt utility; override it with matching importance + higher
     specificity. Lands the title near prod (h1 ≈ 201px; prod 182 no-TOC / 202 TOC)
     within cross-engine tolerance. */
  .markdown-body > div.bp-grid {
    margin-top: -15px !important;
  }
</style>

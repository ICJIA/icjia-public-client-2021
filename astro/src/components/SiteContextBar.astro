---
// Context bar — port of AppNavContext.vue. The thin bar directly below the main
// nav, shown on every page EXCEPT home (matches prod). Two tiers, both driven by
// config/contextMenus.json, keyed on the FIRST path segment of the current URL:
//   1. navy breadcrumb:  ICJIA » {section label} » {contextTitle}
//   2. grey section tabs: the section's items[] as nav links
// `contextTitle` (the 3rd breadcrumb segment) is the per-page title — passed via
// BaseLayout (legacy emitted it through the EventBus "context-label").
import contextMenus from '../config/contextMenus.json';

interface Props {
  contextTitle?: string;
}
const { contextTitle } = Astro.props;

const pathname = Astro.url.pathname;
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const seg = pathname.split('/').filter(Boolean)[0];
const prefix = seg ? `/${seg}/` : null;
// Section-less pages that belong to a section's context bar (their URL lives OUTSIDE
// that section's path prefix). /forms/* is the case today: grant-status is owned by the
// Grants section (and is one of its tabs → auto-highlights); lap-request shows the About
// bar. Add a mapping here if another off-prefix page needs a section bar.
const SECTION_OVERRIDE: Record<string, string> = {
  '/forms/grant-status/': '/grants/',
  '/forms/lap-request/': '/about/',
};
const top = (contextMenus as any[]).filter((m) => m.location === 'top');
const matchedPrefix = prefix && top.some((m) => m.pathPrefix === prefix) ? prefix : null;
const effectivePrefix = matchedPrefix || SECTION_OVERRIDE[norm(pathname)] || null;
const menu = effectivePrefix ? top.find((m) => m.pathPrefix === effectivePrefix) : null;

// Active tab = the item whose path is the LONGEST prefix of the current URL, so
// detail pages (e.g. /news/meetings/<slug>/) keep their section tab active.
let activePath: string | null = null;
if (menu) {
  const here = norm(pathname);
  let best = -1;
  for (const it of menu.items as Array<{ path: string }>) {
    const p = norm(it.path);
    if ((here === p || here.startsWith(p)) && p.length > best) {
      best = p.length;
      activePath = p;
    }
  }
}
---

{
  menu && (
    <div class="ctxbar">
      <nav class="ctx-crumb" aria-label="Breadcrumb">
        <div class="ctx-wrap">
          <a href="/" class="ctx-strong">ICJIA</a>
          <span class="ctx-sep" aria-hidden="true">&nbsp;&raquo;&nbsp;</span>
          <a href={menu.defaultPath} class="ctx-strong">
            <span class="ctx-label-full">{menu.label}</span>
            <span class="ctx-label-short">{menu.shortLabel}</span>
          </a>
          {contextTitle && (
            <span class="ctx-title" title={contextTitle}>
              <span class="ctx-sep" aria-hidden="true">&nbsp;&raquo;&nbsp;</span>
              {contextTitle}
            </span>
          )}
        </div>
        {menu.showTranslation && (
          <button type="button" class="ctx-translate" data-translate-trigger aria-label="Translate this site">
            <svg class="ctx-translate-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="currentColor"><path d="M16.36 14c.08-.66.14-1.32.14-2s-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2M14.59 19.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56M14.34 14H9.66c-.1-.66-.16-1.32-.16-2s.06-1.35.16-2h4.68c.09.65.16 1.32.16 2s-.07 1.34-.16 2M12 19.96c-.83-1.2-1.5-2.53-1.91-3.96h3.82c-.41 1.43-1.08 2.76-1.91 3.96M8 8H5.08A7.92 7.92 0 0 1 9.4 4.44C8.8 5.55 8.35 6.75 8 8M5.08 16H8c.35 1.25.8 2.45 1.4 3.56A8 8 0 0 1 5.08 16M4.26 14c-.16-.64-.26-1.31-.26-2s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2s.06 1.34.14 2M12 4.03c.83 1.2 1.5 2.54 1.91 3.97h-3.82C10.5 6.57 11.17 5.23 12 4.03M18.92 8h-2.95a15.65 15.65 0 0 0-1.38-3.56A8 8 0 0 1 18.92 8M12 2C6.47 2 2 6.5 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2Z"></path></svg>
            <span class="ctx-translate-label">Translate this site</span>
          </button>
        )}
      </nav>

      <nav class="ctx-tabs" aria-label="Section navigation">
        <ul>
          {menu.items.map((item: any) => (
            <li>
              <a
                href={item.path}
                class:list={['ctx-tab', { 'ctx-tab-active': norm(item.path) === activePath }]}
                aria-current={norm(item.path) === activePath ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<style>
  .ctx-crumb {
    background: #0a3a60;
    color: #fff;
    font-size: 15px;
    min-height: 35px;
    display: flex;
    align-items: center;
  }
  .ctx-wrap {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0 16px;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    overflow: hidden;
  }
  /* "Translate this site" — right of the navy breadcrumb (ports prod's AppNavContext
     translate trigger; opens TranslateModal via [data-translate-trigger]). Rendered
     only where the section enables it (contextMenus showTranslation). */
  .ctx-translate {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 16px;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .ctx-translate:hover {
    text-decoration: underline;
  }
  .ctx-translate-icon {
    flex: 0 0 auto;
  }
  /* globe-only on mobile (the full label would crowd the centered breadcrumb); label ≥960 */
  .ctx-translate-label {
    display: none;
  }
  @media (min-width: 960px) {
    .ctx-translate-label {
      display: inline;
    }
  }
  /* mobile: center; md+ : left-aligned (matches prod text-center/text-left split) */
  @media (max-width: 959.98px) {
    .ctx-wrap {
      justify-content: center;
    }
  }
  .ctx-crumb a {
    color: #fff;
    text-decoration: none;
  }
  .ctx-crumb a:hover {
    text-decoration: underline;
  }
  .ctx-strong {
    font-weight: 700;
    white-space: nowrap;
  }
  .ctx-title {
    font-weight: 300;
    display: inline-block;
    max-width: 60ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
  }
  /* label full ≥960px, shortLabel below (Vuetify md edge) */
  .ctx-label-short {
    display: inline;
  }
  .ctx-label-full {
    display: none;
  }
  @media (min-width: 960px) {
    .ctx-label-short {
      display: none;
    }
    .ctx-label-full {
      display: inline;
    }
  }
  /* contextTitle hidden below md (matches prod hidden-sm-and-down) */
  .ctx-title {
    display: none;
  }
  @media (min-width: 960px) {
    .ctx-title {
      display: inline-block;
    }
  }

  .ctx-tabs {
    background: #eee;
    min-height: 35px;
  }
  .ctx-tabs ul {
    list-style: none;
    margin: 0;
    padding: 0 12px;
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0;
    overflow-x: auto;
    white-space: nowrap;
  }
  .ctx-tab {
    display: inline-flex;
    align-items: center;
    height: 35px;
    padding: 0 16px;
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #444;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .ctx-tab:hover {
    color: #000;
  }
  .ctx-tab-active {
    color: #000;
    border-bottom-color: #000;
    font-weight: 700;
  }
</style>

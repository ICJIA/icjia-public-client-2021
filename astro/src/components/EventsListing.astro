---
// /events/ (and /news/events/) listing — live-data SSR, parity with the legacy
// EventsAll.vue + EventToggle.vue:
//   • "ICJIA Events" heading
//   • a List / Calendar view toggle and an "Upcoming and ongoing events only"
//     checkbox (default CHECKED)
//   • LIST view = the proven Alpine x-for + SSR-page-1 baseline pattern over the
//     events-only feed (getEventsCalendarData().eventsList); each row is a green
//     EventCard linking to /events/{slug}/
//   • CALENDAR view = month grid (Alpine) — Today/prev/next + "MMMM YYYY" + a
//     month-only "Month ▾" view-mode control, Sun–Sat header, day cells with
//     today circled and the FULL calendarFeed as colored chips linking by type.
//     Default view, matching legacy.
//
// The calendar grid is fed the legacy's richer `calendarFeed` (events+meetings+
// grants+jobs + synthetic OPEN/DEADLINE point-events), passed in as the
// `calendar` prop; items with hideFromCalendar=true (the base grant/job records)
// are dropped, matching the legacy v-calendar. Chips are colored + linked BY
// contentType (event→green→/events/{slug}/, meeting→blue→/news/meetings/{slug}/,
// funding→indigo→/grants/funding/{slug}/, employment→purple→/about/employment/
// {slug}/). The LIST view stays on the events-only `events` list.
//
// DEVIATIONS from legacy (signed off in the migration brief):
//   1. List rows render the event SUMMARY as plain text (not the rendered
//      details||summary markdown the single page shows) — the data layer doesn't
//      pre-render a body for list items, and the default upcoming filter yields
//      an EMPTY events list on prod today, so this is low-risk. VR-tune follow-up.
import EventCard from './EventCard.astro';
import { filterUpcoming, type EventListItem, type CalendarItem } from '../lib/data';
import '../styles/events.css';

interface Props {
  events: EventListItem[];
  /** Full calendar feed (events+meetings+grants+jobs incl. OPEN/DEADLINE
      point-events) — drives the CALENDAR grid only. The LIST view stays on
      `events` (events-only). */
  calendar?: CalendarItem[];
}
const { events, calendar = [] } = Astro.props;

// Chicago-local day key (YYYY-MM-DD) for an ISO instant — buckets each event
// into the SAME calendar day the rangeLine shows (the legacy v-calendar places
// events by their America/Chicago date). en-CA yields ISO-ordered parts.
const chiDayKey = (iso?: string): string => {
  if (!iso) return '';
  const p = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'America/Chicago',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date(iso));
  const g = (t: string) => p.find((x) => x.type === t)?.value ?? '';
  return `${g('year')}-${g('month')}-${g('day')}`;
};

// Client list data (consumed by Alpine x-for). Keep keys short; rangeLine is
// pre-computed server-side (Chicago getRange wording). sd/ed are Chicago
// day-keys (YYYY-MM-DD) used to bucket each event into the calendar grid.
const listData = events.map((e) => ({
  p: e.fullPath,
  n: e.name,
  c: e.category ?? '',
  r: e.rangeLine,
  s: e.summary ?? '',
  t: e.tags ?? [],
  sd: chiDayKey(e.start),
  ed: chiDayKey(e.end || e.start),
  end: e.end ?? '',
}));
// JSON-in-HTML: neutralize "<" so the data island can't break out of the script.
const listJson = JSON.stringify(listData).replace(/</g, '\\u003c');

// Calendar-grid data (the richer feed): events+meetings+grants+jobs, including
// the synthetic OPEN/DEADLINE point-events. Drop items the legacy hides from the
// calendar (the base grant/job records — only their OPEN/DEADLINE chips show).
// ct = contentType → chip color/link mapping (parity with the legacy v-calendar:
// event→green, meeting→blue, funding→indigo, employment→purple).
const calData = calendar
  .filter((c) => !c.hideFromCalendar)
  .map((c) => ({
    p: c.fullPath,
    n: c.name,
    ct: c.contentType,
    sd: chiDayKey(c.start),
    ed: chiDayKey(c.end || c.start),
  }))
  .filter((c) => c.sd);
const calJson = JSON.stringify(calData).replace(/</g, '\\u003c');

// Server-rendered baseline (SEO / no-JS) = the DEFAULT view (List) with the
// DEFAULT filter (upcomingOnly=true). On prod this is empty today (all 6 events
// are from 2021) — parity reproduces that.
const ssrUpcoming = filterUpcoming(events);
---

<div
  class="events"
  x-data={`{
    all: JSON.parse(document.getElementById('events-data').textContent),
    cal: JSON.parse(document.getElementById('calendar-data').textContent),
    view: 'calendar', upcomingOnly: true, ready: false,
    calY: 0, calM: 0,
    init(){
      const now = new Date();
      this.calY = now.getFullYear(); this.calM = now.getMonth();
      this.ready = true;
    },
    get shown(){
      if(!this.upcomingOnly) return this.all;
      const now = new Date();
      return this.all.filter((it)=>{ if(!it.end) return false; const exp = new Date(it.end); exp.setHours(24,0,0,0); return exp >= now; });
    },
    get empty(){ return this.shown.length === 0; },
    pad2(n){ return n < 10 ? '0' + n : '' + n; },
    dayKey(y, m, d){ return y + '-' + this.pad2(m + 1) + '-' + this.pad2(d); },
    get monthLabel(){
      return new Date(this.calY, this.calM, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    },
    todayKey(){ const n = new Date(); return this.dayKey(n.getFullYear(), n.getMonth(), n.getDate()); },
    eventsFor(key){
      // The calendar grid honors the "upcoming only" filter just like the list
      // (legacy v-calendar parity): with it on, drop items whose end-day is
      // before today (ed >= today's day-key ≈ filterUpcoming's "ends today or
      // later" boundary).
      const tk = this.upcomingOnly ? this.todayKey() : '';
      return this.cal.filter((it)=> it.sd && it.sd <= key && (it.ed || it.sd) >= key && (!tk || (it.ed || it.sd) >= tk));
    },
    chipClass(ct){ return 'cal-event cal-' + (ct || 'event'); },
    get weeks(){
      const first = new Date(this.calY, this.calM, 1);
      const lead = first.getDay();
      const start = new Date(this.calY, this.calM, 1 - lead);
      const tk = this.todayKey();
      const weeks = [];
      let cur = new Date(start);
      for(let w = 0; w < 6; w++){
        const row = [];
        for(let d = 0; d < 7; d++){
          const y = cur.getFullYear(), m = cur.getMonth(), dd = cur.getDate();
          const key = this.dayKey(y, m, dd);
          row.push({ day: dd, key, inMonth: m === this.calM, isToday: key === tk, events: this.eventsFor(key) });
          cur.setDate(dd + 1);
        }
        weeks.push(row);
        if(cur.getMonth() !== this.calM && cur > first && w >= 3) break;
      }
      return weeks;
    },
    prevMonth(){ if(this.calM === 0){ this.calM = 11; this.calY--; } else { this.calM--; } },
    nextMonth(){ if(this.calM === 11){ this.calM = 0; this.calY++; } else { this.calM++; } },
    goToday(){ const n = new Date(); this.calY = n.getFullYear(); this.calM = n.getMonth(); }
  }`}
>
  <div class="page-heading text-center">
    <h1>ICJIA Events</h1>

    <div class="vtoggle mt-3" role="group" aria-label="Events view">
      <button type="button" @click="view = 'list'" :aria-pressed="view === 'list'">
        List View
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
          ><path d="M7 5h14v2H7zm0 8v-2h14v2zM4 4.5A1.5 1.5 0 0 1 5.5 6 1.5 1.5 0 0 1 4 7.5 1.5 1.5 0 0 1 2.5 6 1.5 1.5 0 0 1 4 4.5m0 6A1.5 1.5 0 0 1 5.5 12 1.5 1.5 0 0 1 4 13.5 1.5 1.5 0 0 1 2.5 12 1.5 1.5 0 0 1 4 10.5M7 19v-2h14v2zm-3-2.5A1.5 1.5 0 0 1 5.5 18 1.5 1.5 0 0 1 4 19.5 1.5 1.5 0 0 1 2.5 18 1.5 1.5 0 0 1 4 16.5Z"
          ></path></svg
        >
      </button>
      <button type="button" @click="view = 'calendar'" :aria-pressed="view === 'calendar'">
        Calendar View
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
          ><path d="M19 19H5V8h14m0-5h-1V1h-2v2H8V1H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2Z"
          ></path></svg
        >
      </button>
    </div>

    <div class="upcoming-toggle">
      <input type="checkbox" id="showHideUpcoming" x-model="upcomingOnly" />
      <label for="showHideUpcoming">Upcoming and ongoing events only</label>
    </div>
  </div>

  <script type="application/json" id="events-data" set:html={listJson}></script>
  <script type="application/json" id="calendar-data" set:html={calJson}></script>

  {/* LIST view */}
  <div x-show="view === 'list'" class="mt-8">
    {/* SSR baseline (SEO / no-JS) — the default upcoming-filtered list. Hidden
        once Alpine hydrates. */}
    <div x-show="!ready">
      {
        ssrUpcoming.length === 0 ? (
          <p class="events-empty">There are no upcoming events at this time.</p>
        ) : (
          ssrUpcoming.map((e) => (
            <div class="mb-8">
              <EventCard
                name={e.name}
                category={e.category}
                rangeLine={e.rangeLine}
                summary={e.summary}
                tags={e.tags}
                clickable={true}
                fullPath={e.fullPath}
              />
            </div>
          ))
        )
      }
    </div>

    {/* Interactive list (Alpine x-for) — shown after hydrate. Card markup is
        inlined here (Astro won't evaluate the EventCard component's closures
        inside a native <template>). */}
    <div x-show="ready" x-cloak>
      <template x-for="ev in shown" :key="ev.p">
        <div class="mb-8">
          <a :href="ev.p" class="event-card markdown-body">
            <div class="event-toolbar">
              <span class="event-toolbar-title" x-html="ev.n"></span>
            </div>
            <div class="event-meta">
              <span class="event-cat" x-text="(ev.c ? ev.c.toUpperCase() + ' ' : '') + 'EVENT'"></span>
              <template x-if="ev.r"><span class="event-range" x-text="' | ' + ev.r"></span></template>
            </div>
            <template x-if="ev.s">
              <div class="event-body"><p x-text="ev.s"></p></div>
            </template>
            <template x-if="ev.t && ev.t.length">
              <div class="event-tags">
                <template x-for="tg in ev.t" :key="tg">
                  <a class="chip" :href="`/search/?q=${encodeURIComponent(tg)}`" x-text="tg"></a>
                </template>
              </div>
            </template>
          </a>
        </div>
      </template>

      <p class="events-empty" x-show="empty" x-cloak>There are no upcoming events at this time.</p>
    </div>
  </div>

  {/* CALENDAR view — month grid (Alpine). Parity with the legacy v-calendar:
      Today / prev / next toolbar + "MMMM YYYY" label, Sun–Sat weekday header,
      day cells with the today number circled (primary blue) and events as
      colored chips linking to the detail page. Markup is inlined here (Astro
      won't evaluate component closures inside a native <template>). */}
  <div x-show="view === 'calendar'" x-cloak class="mt-8">
    <div class="cal">
      <div class="cal-toolbar">
        <button type="button" class="cal-today-btn" @click="goToday()">Today</button>
        <div class="cal-nav">
          <button type="button" class="cal-arrow" @click="prevMonth()" aria-label="Previous month">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg>
          </button>
          <button type="button" class="cal-arrow" @click="nextMonth()" aria-label="Next month">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M10 6 8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path></svg>
          </button>
        </div>
        <div class="cal-month-label" aria-live="polite" x-text="monthLabel"></div>
        <div class="cal-spacer"></div>
        {/* View-mode control — month-only (matches legacy's v-calendar MONTH ▾
            dropdown position/look). Disabled: the grid renders month view only. */}
        <button type="button" class="cal-viewmode" disabled aria-label="Calendar view: Month">
          Month
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M7 10l5 5 5-5z"></path></svg>
        </button>
      </div>

      <table class="cal-grid" role="grid" :aria-label="'Events calendar for ' + monthLabel">
        <thead>
          <tr>
            <th scope="col" abbr="Sunday">Sun</th>
            <th scope="col" abbr="Monday">Mon</th>
            <th scope="col" abbr="Tuesday">Tue</th>
            <th scope="col" abbr="Wednesday">Wed</th>
            <th scope="col" abbr="Thursday">Thu</th>
            <th scope="col" abbr="Friday">Fri</th>
            <th scope="col" abbr="Saturday">Sat</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="(week, wi) in weeks" :key="wi">
            <tr>
              <template x-for="cell in week" :key="cell.key">
                <td class="cal-cell" :class="{ 'cal-out': !cell.inMonth, 'cal-today': cell.isToday }">
                  <div class="cal-day-label">
                    <span class="cal-day-num" x-text="cell.day"></span>
                  </div>
                  <div class="cal-events">
                    <template x-for="ev in cell.events" :key="ev.p + ev.n + cell.key">
                      <a :href="ev.p" :class="chipClass(ev.ct)" :title="ev.n"><span x-html="ev.n"></span></a>
                    </template>
                  </div>
                </td>
              </template>
            </tr>
          </template>
        </tbody>
      </table>
    </div>
  </div>
</div>

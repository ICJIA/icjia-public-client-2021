---
// Home click-through boxes — ported from HomeClickThroughBoxes.vue. A row of
// navy (#0E4471) clickable cards: 70px icon, uppercase title, teaser, optional
// "NEW!" badge. Equal width (3 boxes → thirds).
//
// NOTE (VR-tune): the CMS `icon` values are mdi-prefixed but some are actually
// Material Icons names (prod rendered them via its Material fallback). Mapped
// to close MDI equivalents here; if exact glyph parity is needed, add
// @iconify-json/material-symbols and map to those.
import { Icon } from 'astro-icon/components';
import { isNew } from '../lib/data';

interface Props {
  boxes?: any[];
}
const { boxes = [] } = Astro.props;

const ICON_MAP: Record<string, string> = {
  people: 'account-group',
  'pending-actions': 'clipboard-text-clock',
  'account-balance': 'bank',
};
function mdiName(raw?: string): string {
  const n = String(raw || '').replace(/^mdi-/, '');
  return 'mdi:' + (ICON_MAP[n] || n || 'account-group');
}
const isExternal = (url?: string) => !!url && /^https?:\/\//.test(url);
---

{
  boxes.length > 0 && (
    <div class="grid grid-cols-1 gap-[2px] md:grid-cols-3" style="margin-top:-10px">
      {boxes.map((box) => (
        <a
          href={box.url || '#'}
          target={isExternal(box.url) ? '_blank' : undefined}
          rel={isExternal(box.url) ? 'noopener noreferrer' : undefined}
          class="box hover relative block min-h-[400px] px-8 pb-6 pt-11 text-center !text-white no-underline md:min-h-[350px]"
          style="background:#0E4471"
        >
          {isNew(box.datePosted) && (
            <span class="absolute left-4 top-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-blue-800 text-xs font-bold text-white">
              NEW!
            </span>
          )}
          <Icon name={mdiName(box.icon)} class="mx-auto text-[70px]" aria-hidden="true" />
          <h2 class="mt-3 text-[28px] font-black uppercase !text-white">{box.title}</h2>
          <div class="mt-2 text-[16px] font-light !text-white" set:html={box.teaser} />
        </a>
      ))}
    </div>
  )
}

<style>
  .box:hover {
    background: #ccc !important;
  }
  .box:hover,
  .box:hover * {
    color: #000 !important;
  }
</style>

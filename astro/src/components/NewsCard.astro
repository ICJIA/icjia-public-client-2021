---
import { formatNewsDate, newsCategoryLabel, type NewsListItem } from '../lib/data';
import CmsImage from './CmsImage.astro';

interface Props {
  item: NewsListItem;
}
const { item } = Astro.props;
const date = formatNewsDate(item.publicationDate || item.dateOverride || item.published_at);
const cat = newsCategoryLabel(item.category);
const href = `/news/${item.slug}/`;
---

<article class="card flex flex-col overflow-hidden border border-gray-200 bg-white">
  <div class="flex flex-1 flex-col p-4">
    {/* Eyebrow: bold UPPERCASE category | date (matches prod + HomeCardNews). */}
    <p class="mb-1 text-xs font-normal text-gray-600">
      {cat && <span class="font-bold uppercase">{cat}</span>}{cat && date && ' | '}{date}
    </p>
    <h2 class="mb-1 text-lg leading-snug">
      <a href={href} class="!text-black hover:!text-primary">{item.title}</a>
    </h2>
    {item.summary && <p class="text-sm font-normal text-gray-800">{item.summary}</p>}
    {item.tags && item.tags.length > 0 && (
      <div class="mt-3">
        {item.tags.slice(0, 4).map((tag) => (
          <a class="chip" href={`/search/?q=${encodeURIComponent(tag)}`}>{tag}</a>
        ))}
      </div>
    )}
  </div>
  {/* Image BELOW the text with object-contain so the full splash (the square ICJIA
      logo) shows uncropped — prod renders it under the title, not a cropped band. */}
  {
    item.splash?.url && (
      <a href={href} class="block no-underline" tabindex="-1" aria-hidden="true">
        <CmsImage image={item.splash} alt="" class="w-full object-contain" />
      </a>
    )
  }
</article>

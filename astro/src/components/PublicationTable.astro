---
// Publications data table — parity with the legacy PublicationsAll.vue
// (v-data-table): search, sortable Date/Title/Type columns (default
// publicationDate desc; Article + File NOT sortable), rows-per-page
// [100,150,200,250,500] default 150 (NO "All" option, unlike MeetingTable),
// and single-row expand → PublicationCard. Cloned from the proven
// MeetingTable.astro: driven by Alpine x-for (the reliable list primitive — see
// project_astro_alpine_lists) over the #publications-data island the listing
// page renders once; only the current page (≤ perPage rows) is ever in the DOM.
// `baseline` (server-rendered first 150) is the no-JS / crawler / SiteImprove view.
//
// Plausible (verbatim legacy event names, NOT meetings' file_download):
//   Web Article → publicationList_article_view {url: articleURL}
//   Download PDF → publicationList_file_download {url: fileURL}
import type { PublicationListItem } from '../lib/data';
import { Icon } from 'astro-icon/components';

interface Props {
  baseline?: PublicationListItem[];
}
const { baseline } = Astro.props;

const xdata = `{
  all: [], search: '', sortKey: 'date', sortDir: 'desc',
  page: 1, perPage: 150, expanded: null, ready: false, fullLoaded: false,
  init(){
    try { this.all = JSON.parse(document.getElementById('publications-data').textContent); }
    catch (e) { this.all = []; }
    this.index(this.all);
    this.ready = true;
    // LIVE-ISLAND (pilot for the de-serverless live-island pattern): after first
    // paint, fetch the FULL archive straight from the PUBLIC Strapi in the browser
    // via the SAME REST pager the server uses (count + 500-row slices), then swap it
    // in — so new/edited publications appear on reload with NO rebuild. GraphQL clips
    // this list, so REST is the proven path (it is literally the legacy Vue SPA's own
    // client-side method, CORS-open: access-control-allow-origin *). Falls back to the
    // build-baked /api/publications.json if Strapi is unreachable; the SSR ~150 baseline
    // stays the no-JS / crawler / SiteImprove view either way. Mirrors data.ts
    // getAllPublications + shapePublication, minus deepSanitize (unneeded client-side:
    // x-text auto-escapes, and SiteImprove reads the baked HTML, not this swap).
    this.fetchLive()
      .then((rows) => (Array.isArray(rows) && rows.length) ? rows : this.fetchStatic())
      .then((rows) => {
        if (Array.isArray(rows) && rows.length > this.all.length) { this.index(rows); this.all = rows; }
        this.fullLoaded = true;
      })
      .catch(() => { this.fullLoaded = true; });
  },
  // Client-side search string (_h) from the shipped display fields — the heavy
  // full-summary 'haystack' is no longer in the island (it was the ~1.1MB FCP/LCP cost).
  index(arr){ arr.forEach((p) => { p._h = (p.title + ' ' + (p.summary || '') + ' ' + (p.typeLabel || '') + ' ' + (p.tags || []).join(' ')).toLowerCase(); }); },
  get searched(){ const q = this.search.trim().toLowerCase(); return q ? this.all.filter((p) => p._h.includes(q)) : this.all; },
  get sorted(){ const a = [...this.searched], d = this.sortDir === 'asc' ? 1 : -1, k = this.sortKey;
    a.sort((x, y) => { let r = 0;
      if (k === 'date') r = String(x.publicationDate || '').localeCompare(String(y.publicationDate || ''));
      else if (k === 'title') r = x.title.toLowerCase().localeCompare(y.title.toLowerCase());
      else if (k === 'type') r = x.typeLabel.localeCompare(y.typeLabel);
      return r * d; });
    return a; },
  get count(){ return this.sorted.length; },
  get totalPages(){ return Math.max(1, Math.ceil(this.count / this.perPage)); },
  get pageItems(){ const s = (this.page - 1) * this.perPage; return this.sorted.slice(s, s + this.perPage); },
  get rangeText(){ if (!this.count) return '0–0 of 0'; const s = (this.page - 1) * this.perPage + 1; const e = Math.min(this.count, this.page * this.perPage); return s + '–' + e + ' of ' + this.count; },
  setSort(k){ if (this.sortKey === k) this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc'; else { this.sortKey = k; this.sortDir = k === 'date' ? 'desc' : 'asc'; } this.page = 1; },
  ariaSort(k){ return this.sortKey === k ? (this.sortDir === 'asc' ? 'ascending' : 'descending') : null; },
  toggle(id){ this.expanded = this.expanded === id ? null : id; },
  trackArticle(url){ try { if (typeof window.plausible === 'function') window.plausible('publicationList_article_view', { props: { url } }); } catch (e) {} },
  trackDownload(url){ try { if (typeof window.plausible === 'function') window.plausible('publicationList_file_download', { props: { url } }); } catch (e) {} },
  // ── Live-island data layer — client port of data.ts getAllPublications + shapePublication ──
  // (regexes are backslash-free — [0-9] not \\d, space-split not \\s+ — so the x-data
  //  attribute string survives template-literal escaping intact.)
  fetchStatic(){ return fetch('/api/publications.json').then((r) => r.ok ? r.json() : null).catch(() => null); },
  async fetchLive(){
    const BASE = 'https://agency.icjia-api.cloud', SIZE = 500;
    try {
      const cRes = await fetch(BASE + '/publications/count');
      if (!cRes.ok) return null;
      const count = Number(await cRes.json());
      const iters = Math.ceil(count / SIZE);
      let raw = [];
      for (let i = 0; i < iters; i++) {
        const r = await fetch(BASE + '/publications?_limit=' + SIZE + '&_start=' + (i * SIZE));
        if (!r.ok) return null;
        raw = raw.concat(await r.json());
      }
      const seen = new Set(), uniq = [];
      for (const p of raw) { const k = String(p.id); if (!seen.has(k)) { seen.add(k); uniq.push(p); } }
      return uniq.filter((p) => p.slug).map((p) => this.shapePublication(p))
        .sort((a, b) => String(b.publicationDate || '').localeCompare(String(a.publicationDate || '')));
    } catch (e) { return null; }
  },
  shapePublication(p){
    const CLIENT = 'https://icjia.illinois.gov';
    const tags = Array.isArray(p.tags) ? p.tags.map((t) => typeof t === 'string' ? t : (t && t.title)).filter(Boolean) : [];
    const localArticlePath = p.articleURL && p.articleURL.indexOf(CLIENT) !== -1 ? p.articleURL.replace(CLIENT, '') : null;
    return {
      id: String(p.id), title: p.title, summary: this.truncateWords(p.summary, 25),
      pubType: p.pubType, publicationDate: p.publicationDate, tags: tags,
      fileURL: p.fileURL, articleURL: p.articleURL, fullPath: '/about/publications/' + p.slug + '/',
      localArticlePath: localArticlePath, typeLabel: this.publicationTypeLabel(p.pubType),
      dateAlt: this.dateFormatAlt(p.publicationDate), isNew: this.isNewDate(p.publicationDate),
      fileType: this.getFileType(p.fileURL)
    };
  },
  truncateWords(s, max){ if (!s) return ''; const a = s.trim().split(' ').filter(Boolean); const o = a.slice(0, max).join(' '); return a.length > max ? o + '...' : o; },
  isNewDate(iso){ if (!iso) return false; const t = new Date(iso).getTime(); if (Number.isNaN(t)) return false; return (Date.now() - t) / 86400000 <= 5; },
  dateFormatAlt(iso){ if (!iso) return ''; const MA = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']; const m = /^([0-9]{4})-([0-9]{2})-([0-9]{2})$/.exec(iso); if (m) { const mi = Number(m[2]) - 1; return MA[mi] ? MA[mi] + ' ' + m[3] + ', ' + m[1] : ''; } const d = new Date(iso); return Number.isNaN(d.getTime()) ? '' : MA[d.getMonth()] + ' ' + String(d.getDate()).padStart(2, '0') + ', ' + d.getFullYear(); },
  publicationTypeLabel(t){ return ({ researchReport: 'Research Report', researchBulletin: 'Research Bulletin', researchAtAGlance: 'Research At A Glance', trendsAndIssuesUpdate: 'Trends and Issues Update', motorVehicleTheftPublications: 'Motor Vehicle Theft Publication', barj: 'BARJ', compiler: 'Compiler', dataset: 'Dataset', getTheFacts: 'GET THE FACTS', programEvaluationSummary: 'Program Evaluation Summary', megProfiles: 'MEG Profiles', annualReport: 'Annual Report', article: 'Article', report: 'Report', evaluation: 'Evaluation', toolkit: 'Toolkit', onGoodAuthority: 'On Good Authority', application: 'Application' })[t] || 'General'; },
  getFileType(url){ if (!url) return ''; return url.split(/[#?]/)[0].split('.').pop().trim().toUpperCase(); }
}`;
---

<div x-data={xdata}>
  {/* Interactive (JS) view */}
  <div x-show="ready" x-cloak>
    <div class="px-4 pt-4 pb-1">
      <label class="psearch-label" for="psearch">Search</label>
      <input
        id="psearch"
        type="text"
        class="psearch"
        x-model="search"
        @input="page = 1"
        aria-label="Search publications"
      />
    </div>

    {/* Mobile-only sort control (parity with Vuetify v-data-table mobile mode,
        which replaces the sortable column headers with a "Sort by" select <600px). */}
    <div class="psort-mobile px-4 pb-1">
      <label class="psearch-label" for="psort">Sort by</label>
      <select
        id="psort"
        class="psort-select"
        x-model="sortKey"
        @change="sortDir = sortKey === 'date' ? 'desc' : 'asc'; page = 1"
        aria-label="Sort publications by"
      >
        <option value="date">Date</option>
        <option value="title">Title</option>
        <option value="type">Type</option>
      </select>
    </div>

    <table class="ptable" aria-label="Publications">
      <thead>
        <tr>
          <th class="cell-expand"><span class="sr-only">Expand</span></th>
          <th class="cell-date" :aria-sort="ariaSort('date')">
            <button type="button" @click="setSort('date')">
              Date <span class="caret" x-text="sortKey==='date' && sortDir==='asc' ? '▲' : '▼'"></span>
            </button>
          </th>
          <th :aria-sort="ariaSort('title')">
            <button type="button" @click="setSort('title')">
              Title <span class="caret" x-text="sortKey==='title' && sortDir==='asc' ? '▲' : '▼'"></span>
            </button>
          </th>
          <th :aria-sort="ariaSort('type')">
            <button type="button" @click="setSort('type')">
              Type <span class="caret" x-text="sortKey==='type' && sortDir==='asc' ? '▲' : '▼'"></span>
            </button>
          </th>
          <th class="col-center">Article</th>
          <th class="col-center">File</th>
        </tr>
      </thead>
      <template x-for="(it, idx) in pageItems" :key="it.id">
        <tbody>
          <tr class="prow" :class="idx % 2 ? 'prow-alt' : ''" @click="toggle(it.id)">
            <td class="col-center cell-expand">
              <button
                type="button"
                class="row-caret-btn"
                @click.stop="toggle(it.id)"
                :aria-expanded="expanded === it.id ? 'true' : 'false'"
                :aria-label="(expanded === it.id ? 'Collapse' : 'Expand') + ' details for ' + it.title"
              >
                <span class="row-caret" :class="expanded === it.id ? 'open' : ''"><Icon name="mdi:chevron-down" aria-hidden="true" /></span>
              </button>
            </td>
            <td class="cell-date" data-label="Date" x-text="it.dateAlt"></td>
            <td class="cell-title" data-label="Title">
              <template x-if="it.isNew"><span class="new-chip">NEW!</span></template>
              <span x-text="it.title"></span>
            </td>
            <td data-label="Type" x-text="it.typeLabel"></td>
            <td class="col-center" data-label="Article">
              <template x-if="it.localArticlePath">
                <a
                  class="pbtn"
                  :href="it.localArticlePath"
                  @click.stop="trackArticle(it.articleURL)"
                >Web Article</a>
              </template>
            </td>
            <td class="col-center" data-label="File">
              <template x-if="it.fileURL && it.pubType !== 'application'">
                <a
                  class="pbtn"
                  :href="it.fileURL"
                  target="_blank"
                  rel="noopener noreferrer"
                  @click.stop="trackDownload(it.fileURL)"
                >Download PDF</a>
              </template>
              <template x-if="it.fileURL && it.pubType === 'application'">
                <a
                  class="pbtn"
                  :href="it.fileURL"
                  target="_blank"
                  rel="noopener noreferrer"
                  @click.stop="trackDownload(it.fileURL)"
                >Open Application</a>
              </template>
            </td>
          </tr>
          <template x-if="expanded === it.id">
            <tr>
              <td colspan="6">
                <div class="pub-card markdown-body">
                  <template x-if="it.publicationDate">
                    <span class="pub-card-date mb-5 px-3 block" x-text="it.dateAlt"></span>
                  </template>
                  <h2 class="pub-card-title mt-2 mb-3 px-3">
                    <a :href="it.fullPath" x-text="it.title"></a>
                  </h2>
                  <template x-if="it.summary">
                    <div class="pub-card-summary px-3" x-text="it.summary"></div>
                  </template>
                  <template x-if="!it.summary">
                    <div class="pub-card-summary px-3">No summary available</div>
                  </template>
                  <template x-if="it.localArticlePath || it.fileURL">
                    <ul class="pub-links mt-5 ml-2">
                      <template x-if="it.localArticlePath">
                        <li class="mt-2">
                          <span class="link-label">Article&nbsp;</span><br />
                          <a :href="it.localArticlePath" @click.stop="trackArticle(it.articleURL)" x-text="it.articleURL"></a>
                        </li>
                      </template>
                      <template x-if="it.fileURL">
                        <li class="mt-2">
                          <span class="link-label">Download&nbsp;</span><br />
                          <a :href="it.fileURL" target="_blank" rel="noopener noreferrer" @click.stop="trackDownload(it.fileURL)" x-text="it.title"></a>
                          &nbsp;<span class="file-chip" x-text="it.fileType"></span>
                        </li>
                      </template>
                    </ul>
                  </template>
                  <template x-if="it.tags.length">
                    <div class="py-2 px-3">
                      <template x-for="t in it.tags" :key="t"><a class="chip mt-1" :href="`/search/?q=${encodeURIComponent(t)}`" x-text="t"></a></template>
                    </div>
                  </template>
                  <div class="pub-card-archive text-center mt-10 px-3 py-3">
                    Individual publications, as well as old meeting agendas, minutes, and materials,
                    are always available for download from the ICJIA Document Archive:
                    <a href="https://archive.icjia.cloud" target="_blank" rel="noopener noreferrer">https://archive.icjia.cloud</a>
                  </div>
                </div>
              </td>
            </tr>
          </template>
        </tbody>
      </template>
    </table>

    <div class="pfooter">
      <span>Rows per page:</span>
      <select x-model.number="perPage" @change="page = 1" aria-label="Rows per page">
        <option value="100">100</option>
        <option value="150">150</option>
        <option value="200">200</option>
        <option value="250">250</option>
        <option value="500">500</option>
      </select>
      <span x-text="rangeText"></span>
      <span x-show="!fullLoaded" x-cloak class="ml-2 text-sm text-gray-500">loading full archive…</span>
      <button class="pg-arrow" type="button" @click="if (page > 1) page--" :disabled="page <= 1" aria-label="Previous page">‹</button>
      <button class="pg-arrow" type="button" @click="if (page < totalPages) page++" :disabled="page >= totalPages" aria-label="Next page">›</button>
    </div>
  </div>

  {/* SSR baseline (no-JS / crawlers / SiteImprove) — first 150 shaped rows. */}
  {
    baseline && (
      <div x-show="!ready">
        <table class="ptable" aria-label="Publications">
          <thead>
            <tr>
              <th class="cell-expand"><span class="sr-only">Expand</span></th>
              <th class="cell-date">Date</th>
              <th>Title</th>
              <th>Type</th>
              <th class="col-center">Article</th>
              <th class="col-center">File</th>
            </tr>
          </thead>
          <tbody>
            {baseline.map((it, idx) => (
              <tr class:list={['prow', { 'prow-alt': idx % 2 === 1 }]}>
                <td class="col-center cell-expand"><span class="row-caret" aria-hidden="true"><Icon name="mdi:chevron-down" /></span></td>
                <td class="cell-date" data-label="Date">{it.dateAlt}</td>
                <td class="cell-title" data-label="Title">
                  {it.isNew && <span class="new-chip">NEW!</span>}
                  {it.title}
                </td>
                <td data-label="Type">{it.typeLabel}</td>
                <td class="col-center" data-label="Article">
                  {it.localArticlePath && (
                    <a class="pbtn" href={it.localArticlePath}>
                      Web Article
                    </a>
                  )}
                </td>
                <td class="col-center" data-label="File">
                  {it.fileURL && (
                    <a class="pbtn" href={it.fileURL} target="_blank" rel="noopener noreferrer">
                      {it.pubType === 'application' ? 'Open Application' : 'Download PDF'}
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</div>

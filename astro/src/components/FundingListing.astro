---
// /grants/funding/ — live-data SSR, parity with FundingAll.vue: CMS "funding"
// intro (title + body) + a Current/Expired toggle + grant cards (BaseCardExpandable,
// summaryOnly + "Read full NOFO »") + the legacy-GATA note. Current = not expired
// (end + 1 day >= now). Alpine x-for over a JSON island (only the active tab in the
// DOM); SSR baseline = current cards (no-JS / SEO / instant first paint).
import '../styles/funding.css';
import type { FundingListItem, CmsPage } from '../lib/data';

interface Props {
  page: CmsPage | null;
  items: FundingListItem[];
}
const { page, items } = Astro.props;

const current = items.filter((i) => !i.isExpired);
const listJson = JSON.stringify(items).replace(/</g, '\\u003c');
const CJ = 'https://visitor.r20.constantcontact.com/manage/optin?v=001MqUcqqvjwLCJXlLMSWbTe3zHHmEQgFeBuHvBcJWTbwgrxFbDSGx4HSUPpI6DJWMUPgbljtLxffqIcGFTgCnr-auak88ybvRxpoJlTMGPtZs%3D';
---

<div class="funding markdown-body">
  {
    page && (
      <div class="page-heading mb-6">
        <h1 id="current-funding-opportunities">{page.title}</h1>
        {page.safeBodyHtml && <div set:html={page.safeBodyHtml} />}
      </div>
    )
  }

  <div
    x-data={`{
      all: JSON.parse(document.getElementById('funding-data').textContent),
      tab: 'current', ready: false,
      init(){ this.ready = true; },
      get list(){ return this.all.filter((g) => this.tab === 'expired' ? g.isExpired : !g.isExpired); },
      get empty(){ return this.list.length === 0; }
    }`}
  >
    <div class="vtoggle mb-8" role="group" aria-label="Funding status">
      <button type="button" @click="tab = 'current'" :aria-pressed="tab === 'current'">Current</button>
      <button type="button" @click="tab = 'expired'" :aria-pressed="tab === 'expired'">Expired</button>
    </div>

    <script type="application/json" id="funding-data" set:html={listJson}></script>

    {/* SSR baseline (no-JS / SEO): the current opportunities */}
    <div x-show="!ready">
      {
        current.length === 0 ? (
          <div class="f-empty">
            <h3>No current funding opportunities.</h3>
            <p>
              Please check back soon or subscribe to the{' '}
              <a href={CJ} target="_blank" rel="noopener noreferrer">CJ Dispatch</a> for the latest
              ICJIA news and information.
            </p>
          </div>
        ) : (
          current.map((g) => (
            <div class="fcard">
              <div class="mb-6 flex items-start justify-between gap-4">
                <span class="nofo-label">{g.catLabel}</span>
                <span class="f-chip f-chip-green">Deadline: {g.deadlineAlt}</span>
              </div>
              <h2>
                <a href={g.fullPath}>{g.title}</a>
              </h2>
              {g.dateRange && <div class="f-dates">{g.dateRange}</div>}
              {g.summaryHtml && <div class="pt-2 pl-3" set:html={g.summaryHtml} />}
              {g.tags.length > 0 && (
                <div class="mt-3">
                  {g.tags.map((t) => (
                    <span class="chip">{t}</span>
                  ))}
                </div>
              )}
              {g.attachments.length > 0 && (
                <div class="mt-4">
                  <h3 class="sub-heading">Attachments</h3>
                  <ul class="m-0 list-none p-0">
                    {g.attachments.map((a) => (
                      <li class="mt-1">
                        <a class="attachment" href={a.url} target="_blank" rel="noopener noreferrer">
                          {a.name}
                        </a>{' '}
                        <span class="text-xs text-gray-500">({a.niceSize})</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <div class="mt-5">
                <a class="read-nofo" href={g.fullPath}>Read full NOFO&nbsp;&raquo;</a>
              </div>
            </div>
          ))
        )
      }
    </div>

    {/* Interactive (Alpine x-for over the active tab) */}
    <div x-show="ready" x-cloak>
      <template x-if="empty">
        <div class="f-empty">
          <h3 x-text="'No ' + tab + ' funding opportunities.'"></h3>
          <p>
            Please check back soon or subscribe to the
            <a href={CJ} target="_blank" rel="noopener noreferrer">CJ Dispatch</a> for the latest
            ICJIA news and information.
          </p>
        </div>
      </template>

      <template x-for="g in list" :key="g.id">
        <div class="fcard">
          <div class="mb-6 flex items-start justify-between gap-4">
            <span class="nofo-label" x-text="g.catLabel"></span>
            <span
              class="f-chip"
              :class="g.isExpired ? 'f-chip-red' : 'f-chip-green'"
              x-text="(g.isExpired ? 'Expired: ' : 'Deadline: ') + g.deadlineAlt"
            ></span>
          </div>
          <h2><a :href="g.fullPath" x-text="g.title"></a></h2>
          <template x-if="g.dateRange">
            <div class="f-dates" x-text="g.dateRange"></div>
          </template>
          <template x-if="g.summaryHtml">
            <div class="pt-2 pl-3" x-html="g.summaryHtml"></div>
          </template>
          <template x-if="g.tags.length">
            <div class="mt-3">
              <template x-for="t in g.tags" :key="t"><span class="chip" x-text="t"></span></template>
            </div>
          </template>
          <template x-if="g.attachments.length">
            <div class="mt-4">
              <h3 class="sub-heading">Attachments</h3>
              <ul class="m-0 list-none p-0">
                <template x-for="a in g.attachments" :key="a.url">
                  <li class="mt-1">
                    <a class="attachment" :href="a.url" target="_blank" rel="noopener noreferrer" x-text="a.name"></a>
                    <span class="text-xs text-gray-500">(<span x-text="a.niceSize"></span>)</span>
                  </li>
                </template>
              </ul>
            </div>
          </template>
          <div class="mt-5">
            <a class="read-nofo" :href="g.fullPath">Read full NOFO&nbsp;&raquo;</a>
          </div>
        </div>
      </template>
    </div>
  </div>

  <div class="gata-note">
    For funding opportunities prior to 2019, please visit ICJIA's legacy GATA site:{' '}
    <a href="https://legacy-grants.icjia.cloud/grants" target="_blank" rel="noopener noreferrer"
      >https://legacy-grants.icjia.cloud/grants</a
    >
  </div>
</div>

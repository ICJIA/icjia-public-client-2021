---
// Top hero image for CMS pages (news posts, publications, etc.) that carry a
// splash. Ports legacy Splash.vue: a centered, contained image at ~2:1 aspect
// ratio with an optional 12px caption beneath it. Image optimization is handled
// entirely by CmsImage/pickStrapiImage (astro:assets, same-origin) — NO Thumbor.
// Renders nothing when the record has no usable splash image.
import CmsImage from './CmsImage.astro';
import type { StrapiImage } from '../lib/data';

interface Props {
  splash?: StrapiImage | null;
  alt?: string;
  caption?: string;
}
const { splash, alt, caption } = Astro.props;

// Legacy alt precedence: explicit prop -> Strapi alternativeText -> default.
const altText = alt ?? splash?.alternativeText ?? 'ICJIA Internet news item image';
// Caption defaults from the image record (legacy bound :caption to splash.caption).
const captionText = caption ?? splash?.caption;
---

{
  splash?.url && (
    <div class="splash-bleed">
      <CmsImage image={splash} alt={altText} loading="eager" class="splash-img" hero />
      {captionText && <div class="splash-caption">{captionText}</div>}
    </div>
  )
}

<style>
  /* Hero that FILLS the column at a fixed 2:1 box — matches prod's v-img
     aspect-ratio="2" + width:100%. The previous `max-height: 50vw` capped the
     image short on the narrower content column (the "too short" bug); a real
     aspect-ratio box makes it fill the column width and derive its height. */
  /* Prod's CMS splash is CONTAINER-width, NOT a full-viewport bleed: measured
     ~1161px wide / ~581px tall (2:1) inside the v-container at a 1280 viewport. The
     content column here (max-w-[1185px] − px-3) is also 1161px, so a plain
     block-width splash matches prod's hero size exactly. (An earlier 100vw bleed
     blew the hero up to 1280px → 640px tall — ~59px too tall — shoving the title and
     all body content down ~71px on every splash page vs prod.) */
  .splash-bleed {
    margin-bottom: 1.25rem;
  }
  /* .splash-img sizing lives in global.css (.markdown-body img.splash-img) so it
     reliably overrides the vendored github-markdown img rule regardless of Astro
     component scoping. Here we only keep layout that's safe to scope. */
  /* Legacy .splash-caption (Splash.vue). */
  .splash-caption {
    font-size: 12px;
    margin-top: -15px;
    margin-bottom: 25px;
    color: #222;
  }
</style>

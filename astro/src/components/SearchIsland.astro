---
// The search page, shared by /search/ and /search/<query>/ (v1.5.146): the
// markup of the live site's src/views/Search/SearchStatic.vue and
// src/components/SearchCard.vue, measured on the live page. The behaviour is
// src/scripts/search/page.js (Alpine.data "icjiaSearch").
//
// CMS text: titles and summaries go through highlight(), which escapes them
// before marking the typed words, so x-html only ever adds <mark>. Everything
// else is x-text.
import { Icon } from 'astro-icon/components';

interface Props {
  initialQuery?: string;
}
const { initialQuery = '' } = Astro.props;
---

<div class="search-page">
  <div class="search-container">
    <div class="search-island" x-data={`icjiaSearch(${JSON.stringify(initialQuery)})`}>
      <h1 class="search-h1">Search ICJIA</h1>
      <div class="search-sheet">
        <form class="search-form" @submit.prevent="onSearchSubmit()">
          {/* The Vuetify text field: the label floats above once there is
              text or focus; a clear button at the right. No placeholder: it
              repeated the label. */}
          <div class="search-field" :class="{ 'search-field--filled': query }">
            <label for="search-q" class="search-field__label">Search</label>
            <div class="search-field__slot">
              <input
                id="search-q"
                x-ref="input"
                type="text"
                aria-label="Search ICJIA"
                autocomplete="off"
                x-model="query"
                @input="onQueryInput()"
                class="search-field__input"
              />
              <button
                type="button"
                class="search-field__clear"
                aria-label="clear icon"
                x-show="query"
                x-cloak
                @click="clearQuery()"
              >
                <Icon name="mdi:close" aria-hidden="true" />
              </button>
            </div>
          </div>

          <div class="sr-only" role="status" aria-live="polite" x-text="statusMessage"></div>

          <div class="search-unavailable" x-show="ready && error" x-cloak>
            Search is temporarily unavailable. Please try again later.
          </div>

          <template x-if="query && query.length">
            <div class="search-toolbar" role="region" aria-label="Filter search results">
              <div class="search-toolbar__summary">
                <span class="search-toolbar__count">
                  <strong x-text="filteredResults.length"></strong>
                  of <strong x-text="queryResults.length"></strong>
                  <span x-text="queryResults.length === 1 ? 'result' : 'results'"></span>
                </span>
                <span class="search-toolbar__for">
                  for <em x-text="`“${query}”`"></em>
                </span>
                <div x-show="missingWords.length" class="search-toolbar__groups"
                  x-text="`Nothing contains ${quotedMissing}. Showing results for ${quotedWords}.`"></div>
                <div x-show="searchedSynonyms.length" class="search-toolbar__groups"
                  x-text="`Also searched for ${quotedSynonyms}.`"></div>
                <div x-show="similarResults.length" class="search-toolbar__groups">
                  <template x-if="wordResults.length">
                    <span><strong x-text="wordResults.length"></strong>
                      <span x-text="`contain${wordResults.length === 1 ? 's' : ''} ${quotedWords}`"></span></span>
                  </template>
                  <template x-if="!wordResults.length">
                    <span x-text="`None contain ${quotedWords}`"></span>
                  </template>
                  &middot; <strong x-text="similarResults.length"></strong> similar
                </div>
              </div>

              <div class="search-toolbar__chips" role="group" aria-label="Filter by content type">
                <template x-for="(column, c) in filterChipColumns" :key="c">
                  <div class="search-toolbar__column">
                    <template x-for="row in column" :key="row.key">
                      <div :role="row.label ? 'group' : null" :aria-labelledby="row.label ? `${row.key}-row-label` : null">
                        <p :id="row.label ? `${row.key}-row-label` : null" class="search-toolbar__row-label"
                          :aria-hidden="row.label ? null : 'true'" x-text="row.label || ' '"></p>
                        <div class="search-toolbar__row">
                          <template x-for="group in row.groups" :key="group.key">
                            <div class="filter-chip-set"
                              :class="group.caption ? ['filter-chip-set--captioned', `filter-chip-set--${group.key}`] : []"
                              :role="group.caption ? 'group' : null"
                              :aria-labelledby="group.caption ? group.caption.id : null">
                              <div class="filter-chip-set__chips">
                                <template x-for="chip in group.chips" :key="chip.value || 'all'">
                                  <button type="button" class="filter-chip"
                                    :class="{ 'filter-chip--active': isChipActive(chip) }"
                                    :aria-pressed="isChipActive(chip) ? 'true' : 'false'"
                                    @click="selectChip(chip)">
                                    <span x-text="chip.label"></span>
                                    <span class="filter-chip__count" x-text="chip.count"></span>
                                  </button>
                                </template>
                              </div>
                              <template x-if="group.caption">
                                <p :id="group.caption.id" class="filter-chip-set__caption" x-text="group.caption.text"></p>
                              </template>
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>
                  </div>
                </template>
              </div>

              {/* "Newest first": Vuetify's switch, as a checkbox with the switch role. */}
              <div class="search-toolbar__sort">
                <label class="search-switch">
                  <input type="checkbox" role="switch" class="search-switch__input"
                    x-model="sortSwitch" @change="announceSort()" />
                  <span class="search-switch__control" aria-hidden="true">
                    <span class="search-switch__track"></span>
                    <span class="search-switch__thumb"></span>
                  </span>
                  <span class="search-switch__label">Newest first</span>
                </label>
              </div>

              <div x-show="orderedResults.length" class="search-download" role="group"
                aria-labelledby="search-download-label">
                <p id="search-download-label" class="search-download__label">
                  <Icon name="mdi:download" class="search-download__label-icon" aria-hidden="true" />
                  <span x-text="`Download ${orderedResults.length === 1 ? 'this' : 'these'} ${orderedResults.length} result${orderedResults.length === 1 ? '' : 's'}`"></span>
                </p>
                <div class="search-download__buttons">
                  <button type="button" class="search-download__button" :disabled="downloading" @click="downloadResults('xlsx')">
                    <Icon name="mdi:microsoft-excel" aria-hidden="true" /> Excel (.xlsx)
                  </button>
                  <button type="button" class="search-download__button" :disabled="downloading" @click="downloadResults('csv')">
                    <Icon name="mdi:file-delimited-outline" aria-hidden="true" /> CSV (.csv)
                  </button>
                  <button type="button" class="search-download__button" :disabled="downloading" @click="downloadResults('json')">
                    <Icon name="mdi:code-json" aria-hidden="true" /> JSON (.json)
                  </button>
                </div>
              </div>
            </div>
          </template>

          <div x-show="query && query.length" x-cloak class="search-results" @focusin="noteResult($event)" @click.capture="noteResult($event)">
            <template x-for="(result, index) in visibleWordResults" :key="result.item.fullPath + index">
              <div class="search-result" :data-result-index="index">
                <div class="search-card" @click="onCardClick($event, result.item)">
                  <div class="search-card__body">
<div>
                    <div>
                      <span class="search-content-type" x-show="result.item.contentType"><template x-for="(link, i) in typeLinks(result.item)" :key="link.label">
                          <span><span x-text="i ? ' ' : ''"></span><a :href="link.href" class="search-chip-link" x-text="link.label"></a></span>
                        </template></span><template x-for="part in cardDates(result.item)" :key="part">
                        <span x-text="` | ${part}`"></span>
                      </template><span x-show="result.item.isCancelled">&nbsp;|&nbsp; <span class="search-card__cancelled">CANCELLED</span></span>
                    </div>
                    <div class="search-card__gap"></div>
                    <h2 class="search-card__title" x-show="result.item.title">
                      <template x-if="isExternal(result.item)">
                        <a :href="result.item.fullPath" target="_blank" rel="noopener noreferrer" class="card-title-link"><span x-html="highlight(result.item.title)"></span><Icon name="mdi:open-in-new" class="search-card__external" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
                      </template>
                      <template x-if="!isExternal(result.item)">
                        <a :href="result.item.fullPath" class="card-title-link"><span x-html="highlight(result.item.title)"></span></a>
                      </template>
                    </h2>
                  </div>
                  <div x-show="cardText(result.item)" class="search-card__text" x-html="highlight(cardText(result.item))"></div>
                  <template x-for="tag in (result.item.tags || [])" :key="tag">
                    <a :href="searchHref(tag)" class="search-tag" :class="{ 'search-tag-hit': tagHit(tag) }" x-text="tag"></a>
                  </template>
</div>
                </div>
              </div>
            </template>

            <div x-show="similarResults.length && visibleWordResults.length === wordResults.length" class="search-similar">
              <h2 class="search-similar__title">Similar spellings and partial matches</h2>
              <p class="search-similar__note" x-text="similarNote"></p>
              <button type="button" class="search-btn" x-show="wordResults.length"
                :aria-expanded="similarOpen ? 'true' : 'false'" aria-controls="search-similar-results"
                @click="toggleSimilar()"
                x-text="similarOpen ? 'Hide similar results' : `Show ${similarResults.length} similar result${similarResults.length === 1 ? '' : 's'}`"></button>
            </div>
            <div id="search-similar-results">
              <template x-for="(result, index) in visibleSimilarResults" :key="result.item.fullPath + index">
                <div class="search-result" :data-result-index="wordResults.length + index">
                  <div class="search-card" @click="onCardClick($event, result.item)">
                    <div class="search-card__body">
<div>
                      <div>
                        <span class="search-content-type" x-show="result.item.contentType"><template x-for="(link, i) in typeLinks(result.item)" :key="link.label">
                            <span><span x-text="i ? ' ' : ''"></span><a :href="link.href" class="search-chip-link" x-text="link.label"></a></span>
                          </template></span><template x-for="part in cardDates(result.item)" :key="part">
                          <span x-text="` | ${part}`"></span>
                        </template><span x-show="result.item.isCancelled">&nbsp;|&nbsp; <span class="search-card__cancelled">CANCELLED</span></span>
                      </div>
                      <div class="search-card__gap"></div>
                      <h2 class="search-card__title" x-show="result.item.title">
                        <template x-if="isExternal(result.item)">
                          <a :href="result.item.fullPath" target="_blank" rel="noopener noreferrer" class="card-title-link"><span x-html="highlight(result.item.title)"></span><Icon name="mdi:open-in-new" class="search-card__external" aria-hidden="true" /><span class="sr-only"> (opens in a new tab)</span></a>
                        </template>
                        <template x-if="!isExternal(result.item)">
                          <a :href="result.item.fullPath" class="card-title-link"><span x-html="highlight(result.item.title)"></span></a>
                        </template>
                      </h2>
                    </div>
                    <div x-show="cardText(result.item)" class="search-card__text" x-html="highlight(cardText(result.item))"></div>
                    <template x-for="tag in (result.item.tags || [])" :key="tag">
                      <a :href="searchHref(tag)" class="search-tag" :class="{ 'search-tag-hit': tagHit(tag) }" x-text="tag"></a>
                    </template>
</div>
                  </div>
                </div>
              </template>
            </div>

            <div x-show="visibleResults.length < listedResults.length" class="search-more">
              <button type="button" class="search-btn" @click="showMore()">Show more results</button>
            </div>
            <div x-show="listedResults.length > resultsPerPage" class="search-shown" data-shown>
              <span x-show="visibleResults.length < listedResults.length"
                x-text="`Showing ${visibleResults.length} of ${listedResults.length} results`"></span>
              <span x-show="visibleResults.length >= listedResults.length"
                x-text="`Showing all ${listedResults.length} results`"></span>
            </div>

            <div x-show="showEmpty" class="search-empty">
              <p class="search-empty__title">No results for <em x-text="`“${query}”`"></em>.</p>
              <p class="search-empty__hint">Try fewer or different words, or start from one of these pages:</p>
              <ul class="search-empty__pages">
                <template x-for="page in emptyStatePages" :key="page.path">
                  <li><a :href="page.path" x-text="page.label"></a></li>
                </template>
              </ul>
            </div>
            <div x-show="query.length > 0 && query.length < 2" class="search-empty search-empty--hint">
              Keep typing — search starts at 2 characters.
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  import '../scripts/search/page.js';
</script>

<style is:global>
  [x-cloak] { display: none !important; }
  /* Vuetify's container: 900 / 1185 / 1785 px wide at md / lg / xl, 12 px
     padding; the page's mt-12; the white sheet's px-3 py-1; the form's pl-2. */
  .search-page { margin: 48px 0; font-family: Lato, -apple-system, "system-ui", "Segoe UI", sans-serif; }
  .search-container { width: 100%; margin: 0 auto; padding: 12px; }
  @media (min-width: 960px) { .search-container { max-width: 900px; } }
  @media (min-width: 1264px) { .search-container { max-width: 1185px; } }
  @media (min-width: 1904px) { .search-container { max-width: 1785px; } }
  /* The site's global type (Oswald headings, weight-900 links) is not this
     page's: the live search page is Lato throughout. */
  .search-page h1, .search-page h2, .search-page p, .search-page a, .search-page button, .search-page input { font-family: inherit; }
  .search-h1 { font-size: 32px; font-weight: 700; line-height: 48px; color: rgba(0, 0, 0, 0.87); margin: 0; }
  .search-sheet { background: #fff; padding: 4px 12px; min-height: 100vh; }
  .search-form { padding-left: 8px; margin-top: 16px; }

  /* The Vuetify text field. */
  .search-field { position: relative; margin-top: 4px; padding-top: 12px; margin-bottom: 26px; }
  .search-field__label {
    position: absolute; left: 0; top: 18px; font-size: 16px; font-weight: 900; line-height: 20px;
    color: rgba(0, 0, 0, 0.6); transform-origin: top left; transition: transform 0.3s, color 0.3s; pointer-events: none;
  }
  .search-field--filled .search-field__label, .search-field:focus-within .search-field__label { transform: translateY(-18px) scale(0.75); }
  .search-field:focus-within .search-field__label { color: #1565c0; }
  .search-field__slot { position: relative; display: flex; align-items: center; min-height: 40px; }
  .search-field__slot::before { content: ""; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 1px solid rgba(0, 0, 0, 0.42); }
  .search-field__slot::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 2px solid #1565c0; transform: scaleX(0); transition: transform 0.3s; }
  .search-field:focus-within .search-field__slot::after { transform: scaleX(1); }
  .search-field__input {
    flex: 1; min-width: 0; height: 32px; padding: 8px 0; border: 0; outline: none; background: transparent;
    font: inherit; font-size: 16px; font-weight: 900; line-height: 20px; color: rgba(0, 0, 0, 0.87);
  }
  /* Focus shows as the live field shows it: the 2 px blue underline and the
     blue label (WCAG 2.4.7), not the site's global outline. */
  @layer base { .search-page .search-field__input:focus-visible { outline: none !important; } }
  .search-field__clear { display: inline-flex; margin-left: 4px; width: 24px; height: 24px; padding: 0; border: 0; background: none; cursor: pointer; color: rgba(0, 0, 0, 0.54); }
  .search-field:focus-within .search-field__clear { color: #1565c0; }
  .search-field__clear svg { width: 24px; height: 24px; }
  .search-unavailable { margin: 8px 0; font-size: 14px; color: #b00020; }

  /* The toolbar (SearchStatic.vue's styles, as they are). */
  .search-toolbar { margin-top: 4px; padding: 14px 16px 8px; background: #f3f5f8; border: 1px solid #dde3ea; border-radius: 6px; }
  .search-toolbar__summary { font-size: 14px; color: #333; margin-bottom: 10px; line-height: 1.4; }
  .search-toolbar__count strong { font-weight: 700; color: #000; }
  .search-toolbar__for { color: #666; }
  .search-toolbar__chips { display: flex; align-items: flex-start; gap: 8px 14px; }
  .search-toolbar__column { display: flex; flex-direction: column; gap: 8px; }
  .search-toolbar__column + .search-toolbar__column { flex: 1; min-width: 0; }
  .search-toolbar__column .search-toolbar__row-label {
    margin: 0 0 4px; font-size: 11px; font-weight: 700; line-height: 1.4; letter-spacing: 0.5px; text-transform: uppercase; color: #595959;
  }
  .search-toolbar__row { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 6px; }
  @media (max-width: 600px) {
    .search-toolbar__chips { flex-direction: column; }
    .search-toolbar__column .search-toolbar__row-label[aria-hidden="true"] { display: none; }
  }
  .search-toolbar__sort { margin-top: 10px; }
  .search-toolbar__groups { margin-top: 2px; }
  .search-toolbar__groups strong { font-weight: 700; color: #000; }
  .filter-chip-set, .filter-chip-set__chips { display: contents; }
  .filter-chip-set--captioned { display: inline-flex; flex-direction: column; min-width: 0; }
  .filter-chip-set--captioned .filter-chip-set__chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter-chip-set--hub { --set-colour: #0d47a1; }
  .filter-chip-set--publications { --set-colour: #14532d; }
  .filter-chip-set--captioned .filter-chip-set__caption { width: 0; min-width: 100%; margin: 4px 0 0; font-size: 11px; line-height: 1.4; color: var(--set-colour); }
  .filter-chip-set__caption::before { content: ""; display: block; height: 5px; margin-bottom: 2px; border: solid var(--set-colour); border-width: 0 2px 2px; }
  .filter-chip-set--publications .filter-chip-set__caption { width: auto; min-width: 0; white-space: nowrap; }
  .filter-chip-set--captioned .filter-chip:not(.filter-chip--active):not(:hover) { border-color: var(--set-colour); color: var(--set-colour); }
  .filter-chip {
    display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; background: #fff; color: #000;
    border: 2px solid #222; border-radius: 999px; font: inherit; font-size: 11px; font-weight: 700; letter-spacing: 0.4px;
    text-transform: uppercase; line-height: 1.4; cursor: pointer;
    transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }
  .filter-chip:hover { background: #1565c0; color: #fff; border-color: #1565c0; }
  .filter-chip--active, .filter-chip--active:hover { background: #000; color: #fff; border-color: #000; }
  .filter-chip__count { font-size: 10px; font-weight: 600; background: rgba(0, 0, 0, 0.08); color: inherit; padding: 1px 6px; border-radius: 999px; min-width: 18px; text-align: center; }
  .filter-chip--active .filter-chip__count { background: rgba(255, 255, 255, 0.22); }

  /* The Vuetify switch: a 32 x 12 track, an 18 px thumb, the site's blue when on. */
  .search-switch { display: flex; height: 24px; align-items: center; gap: 8px; cursor: pointer; position: relative; }
  .search-switch__input { position: absolute; opacity: 0; width: 38px; height: 24px; margin: 0; cursor: pointer; }
  .search-switch__control { position: relative; width: 38px; height: 24px; flex: none; }
  .search-switch__track { position: absolute; top: 5px; left: 2px; width: 32px; height: 12px; border-radius: 8px; background: rgba(0, 0, 0, 0.38); opacity: 0.6; }
  .search-switch__thumb {
    position: absolute; top: 2px; left: 0; width: 18px; height: 18px; border-radius: 50%; background: #fff;
    box-shadow: 0 2px 4px -1px rgba(0, 0, 0, 0.2), 0 4px 5px 0 rgba(0, 0, 0, 0.14), 0 1px 10px 0 rgba(0, 0, 0, 0.12);
    transition: transform 0.2s;
  }
  .search-switch__input:checked + .search-switch__control .search-switch__track { background: #1565c0; }
  .search-switch__input:checked + .search-switch__control .search-switch__thumb { background: #1565c0; transform: translateX(20px); }
  .search-switch__input:focus-visible + .search-switch__control .search-switch__thumb { outline: 2px solid #1565c0; outline-offset: 4px; }
  .search-switch__label { font-size: 14px; line-height: 20px; color: #333; }

  /* The downloads (v1.5.144). */
  .search-download { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-top: 14px; padding-top: 12px; border-top: 1px solid #ddd; }
  .search-download__label { margin: 0; font-size: 14px; font-weight: 700; color: #222; display: inline-flex; align-items: center; gap: 4px; }
  .search-download__label-icon { width: 16px; height: 16px; color: #0d47a1; }
  .search-download__buttons { display: flex; flex-wrap: wrap; gap: 8px; }
  .search-download__button {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 14px; border: 2px solid #0d47a1;
    border-radius: 4px; background: #fff; color: #0d47a1; font: inherit; font-size: 14px; font-weight: 700; cursor: pointer;
  }
  .search-download__button svg { width: 16px; height: 16px; }
  .search-download__button:hover, .search-download__button:focus-visible { background: #0d47a1; color: #fff; }
  .search-download__button:focus-visible { outline: 3px solid #ffbf47; outline-offset: 2px; }
  .search-download__button:disabled { opacity: 0.6; cursor: progress; }

  /* The results and their cards (SearchCard.vue). */
  .search-results { margin: 48px 0; }
  .search-result { margin: 16px 0; }
  .search-card {
    background: #fff; border: 1px solid #ccc; border-radius: 4px; padding: 12px; margin-bottom: 12px;
    font-size: 16px; line-height: 24px; color: rgba(0, 0, 0, 0.87); cursor: pointer;
  }
  .search-card:hover { background: #fafafa; }
  .search-card__body { font-size: 14px; line-height: 1.5; overflow-wrap: break-word; }
  .search-card__gap { height: 10px; }
  .search-content-type { font-weight: 700; color: #000; }
  .search-chip-link, .search-chip-link:hover { color: inherit; font-weight: inherit; text-decoration: none; }
  .search-content-type:hover { text-decoration: underline; }
  .search-card__cancelled { color: #000; font-weight: 900; }
  .search-card__title { display: inline; font-size: 16px; line-height: 1.5; font-weight: 700; margin: 8px 0; }
  .card-title-link { color: rgba(0, 0, 0, 0.87); font-weight: inherit; text-decoration: none; }
  .card-title-link:hover { color: #000; text-decoration: underline; }
  .search-card__external { display: inline-block; width: 16px; height: 16px; margin-left: 8px; vertical-align: -2px; color: #000; }
  .search-card__text { margin: 8px 0; }
  .search-hit { background-color: #fff2a8; color: #000; border-radius: 2px; padding: 0 1px; }
  .search-tag {
    display: inline-block; margin: 6px 12px 0 0; padding: 4px 8px; background: #eee; border-radius: 25px;
    font-family: Lato, sans-serif !important; font-size: 10px; font-weight: 700; line-height: 15px; color: #000;
    text-transform: uppercase; text-decoration: none; cursor: pointer;
  }
  .search-tag:hover { background: #ddd; color: #000; text-decoration: underline; }
  .search-tag-hit { background: #fff2a8; box-shadow: inset 0 0 0 1px #595959; }
  .search-tag-hit:hover { background: #ffe97a; }
  @media (forced-colors: active) {
    .search-hit, .search-tag-hit, .search-tag-hit:hover { background-color: Mark; color: MarkText; }

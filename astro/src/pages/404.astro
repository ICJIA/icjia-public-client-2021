---
// Standard ICJIA 404 — stylish, on-brand (BaseLayout + hero band + GET /search/
// hand-off + quick-link grid + help line). noindex (followable).
//
// SMART 404 (new): the site is a static build, so a brand-new CMS slug 404s until
// the next rebuild. To avoid a dead end, a client check looks at the unmatched path;
// if it's a known content-detail route AND the record EXISTS in Strapi (public REST),
// the page is "published but not yet built" → we show a "being published" state
// instead of a hard 404. Hosts come from sources.ts (single source of truth); the
// collection names mirror the [slug] detail routes. The check is browser-only (this
// page is prerendered at /404, served by Netlify for any miss — no function per hit).
//
// Parity with legacy src/views/404.vue: same destination set + the Plausible "404"
// event (path prop) fired on load.
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import { AGENCY, HUB } from '../lib/live/sources';
// Content CSS for the live-detail render (the 404 is now the universal preview
// shell for post-build slugs). inlineStylesheets:'always' inlines these into
// 404.html. One stylesheet per detail type the renderer registry supports.
import '../styles/meetings.css';
import '../styles/funding.css';
import '../styles/attachment-list.css';
import '../styles/page-toc.css';
import '../styles/events.css';
import '../styles/article-view.css';
import '../styles/researchhub.css';
import '../styles/publications.css';
import '../styles/bios.css';
import '../styles/employment.css';
import '../styles/github-markdown.css';

// Quick links mirror legacy 404.vue (Home + the seven section destinations).
const links = [
  { label: 'ICJIA Home', href: '/' },
  { label: 'Funding Opportunities', href: '/grants/funding/' },
  { label: 'Research Hub', href: '/researchhub/' },
  { label: 'Public Meetings', href: '/news/meetings/' },
  { label: 'News & Press', href: '/news/press/' },
  { label: 'Employment', href: '/about/employment/' },
  { label: 'Innovation & Digital Services', href: '/innovation-and-digital-services/' },
  { label: 'Contact ICJIA', href: '/about/contact/' },
];

// Ordered most-specific-first: the first matching prefix wins (so /news/meetings/
// matches meetings before /news/ matches posts). q = extra REST query (researchhub
// gates on a custom `status` field → needs status=published, unlike the agency
// collections' built-in publish state). Collections are confirmed in sources.ts.
const DETECT = [
  { prefix: '/researchhub/articles/', host: HUB, coll: 'articles', q: 'status=published' },
  { prefix: '/researchhub/datasets/', host: HUB, coll: 'datasets', q: 'status=published' },
  { prefix: '/researchhub/apps/', host: HUB, coll: 'apps', q: 'status=published' },
  { prefix: '/news/meetings/', host: AGENCY, coll: 'meetings', q: '' },
  { prefix: '/news/press/', host: AGENCY, coll: 'posts', q: '' },
  { prefix: '/news/', host: AGENCY, coll: 'posts', q: '' },
  { prefix: '/events/', host: AGENCY, coll: 'events', q: '' },
  { prefix: '/grants/funding/', host: AGENCY, coll: 'grants', q: '' },
  { prefix: '/grants/programs/', host: AGENCY, coll: 'programs', q: '' },
  { prefix: '/about/publications/', host: AGENCY, coll: 'publications', q: '' },
  { prefix: '/about/biographies/', host: AGENCY, coll: 'biographies', q: '' },
  { prefix: '/about/employment/', host: AGENCY, coll: 'jobs', q: '' },
  { prefix: '/about/units/', host: AGENCY, coll: 'units', q: '' },
  // BROAD CMS-page prefixes (the `pages` collection) — LAST, after every specific
  // /about/* and /grants/* entry, since the loop takes the FIRST matching prefix.
  { prefix: '/about/', host: AGENCY, coll: 'pages', q: '' },
  { prefix: '/grants/', host: AGENCY, coll: 'pages', q: '' },
  { prefix: '/irb/', host: AGENCY, coll: 'pages', q: '' },
  { prefix: '/innovation-and-digital-services/', host: AGENCY, coll: 'pages', q: '' },
];
const detectJson = JSON.stringify(DETECT).replace(/</g, '\\u003c');
---

<BaseLayout title="Page Not Found" description="The page you requested could not be found." noindex>
  <section class="nf" data-nf>
    <div class="nf-inner">
      {/* The 404 numeral + "not found" copy are hidden by CSS until JS sets
          [data-nf-state='gone'] (a confirmed miss). A detail-route candidate paints the
          neutral "checking" state — never "not found" — until the Strapi check resolves,
          so there is NO "404 flash" regardless of JS/paint timing. */}
      <script type="application/json" id="nf-detect" set:html={detectJson} is:inline />
      {/* RAW inline JS (NOT wrapped in a {`…`} expression): is:inline emits content
          verbatim, so a {`…`} wrapper would ship as a literal block + template-string
          and the IIFE would never run — the bug that left the smart-404 detection dead.
          Kept inline + classic so it runs DURING parse. It sets [data-nf-state] in BOTH
          branches: 'checking' for a detail candidate, 'gone' for a real miss (or on
          error) — so the hidden-by-default 404 copy is revealed ONLY for a confirmed miss. */}
      <script is:inline>
        (() => {
          var sec = document.querySelector('[data-nf]');
          if (!sec) return;
          try {
            var map = JSON.parse(document.getElementById('nf-detect').textContent);
            var p = location.pathname;
            var matched = false;
            for (var i = 0; i < map.length; i++) {
              var e = map[i];
              if (p.indexOf(e.prefix) === 0) {
                var slug = p.slice(e.prefix.length).replace(/\/$/, '');
                if (slug && slug.indexOf('/') === -1) {
                  sec.setAttribute('data-nf-slug', slug);
                  sec.setAttribute('data-nf-prefix', e.prefix);
                  sec.setAttribute('data-nf-url', e.host + '/' + e.coll + '?slug=' + encodeURIComponent(slug) + (e.q ? '&' + e.q : '') + '&_limit=5');
                  sec.setAttribute('data-nf-state', 'checking');
                  document.title = 'ICJIA';
                  // Watchdog: the resolver's 6s fetch timeout lives in the BUNDLED chunk;
                  // if that chunk fails to download, don't sit on "checking" forever —
                  // reveal the real 404 after 10s. No-op once the resolver settles (state
                  // is no longer 'checking'). Defense-in-depth for the hidden-by-default 404.
                  setTimeout(function () { if (sec.getAttribute('data-nf-state') === 'checking') sec.setAttribute('data-nf-state', 'gone'); }, 10000);
                  matched = true;
                  break;
                }
              }
            }
            if (!matched) sec.setAttribute('data-nf-state', 'gone');
          } catch (_) {
            sec.setAttribute('data-nf-state', 'gone');
          }
        })();
      </script>

      {/* JS disabled → the smart fallback can't run; reveal the standard 404. is:inline
          keeps this <style> in place (un-hoisted) so it only applies inside <noscript>. */}
      <noscript>
        <style is:inline>
          [data-nf] .nf-num, [data-nf] .nf-msg--default { display: block !important; }
          [data-nf] .nf-msg--checking, [data-nf] .nf-msg--publishing { display: none !important; }
        </style>
      </noscript>

      <div class="nf-num" aria-hidden="true">404</div>

      {/* Three mutually-exclusive states, swapped by [data-nf-state] (CSS below). */}
      <div class="nf-msg nf-msg--default">
        <h1 class="nf-head">We couldn&rsquo;t find that page</h1>
        <p class="nf-sub">
          The page may have moved, been renamed, or no longer exists. Try a search,
          or pick up one of the links below.
        </p>
      </div>
      <div class="nf-msg nf-msg--checking" aria-live="polite">
        <h1 class="nf-head">One moment&hellip;</h1>
        <p class="nf-sub">Checking whether this page is being published&hellip;</p>
      </div>
      <div class="nf-msg nf-msg--publishing" aria-live="polite">
        <h1 class="nf-head">This page is being published</h1>
        <p class="nf-sub">
          Good news &mdash; this content exists and is being prepared. New pages usually
          appear within a few minutes. Please check back shortly, or try again.
        </p>
        <p class="nf-retry-wrap">
          <button type="button" class="nf-search-btn" id="nf-retry">Try again</button>
        </p>
      </div>

      <form method="get" action="/search/" role="search" class="nf-search">
        <label for="nf-q" class="sr-only">Search ICJIA</label>
        <input
          id="nf-q"
          type="search"
          name="q"
          placeholder="Search ICJIA&hellip;"
          autocomplete="off"
          class="nf-search-input"
        />
        <button type="submit" class="nf-search-btn">Search</button>
      </form>

      <nav class="nf-grid" aria-label="Helpful links">
        {
          links.map((l) => (
            <a href={l.href} class="nf-card">
              <span class="nf-card-label">{l.label}</span>
              <span class="nf-card-arrow" aria-hidden="true">&rsaquo;</span>
            </a>
          ))
        }
      </nav>

      <p class="nf-help">
        Still stuck? <a href="/about/contact/">Contact ICJIA</a> and we&rsquo;ll help you find it.
      </p>
    </div>
  </section>
</BaseLayout>

{/* Resolver (bundled module — NOT is:inline — so the dynamic import() is bundled):
    if the early script flagged a candidate, REST-check Strapi. A record whose slug
    matches is "published but not yet built" →
      • renderer exists for this type  → render it CLIENT-SIDE in place (the author
        sees their content immediately; the nightly rebuild then mints the canonical
        optimized + indexed page). See docs/LIVE-DETAIL-FALLBACK.md.
      • no renderer yet                → the "being published" notice (graceful).
    No match / error / timeout → the normal 404. The detail-preview module (with the
    markdown bundle) is imported ONLY on a hit, so plain 404s stay light. Defensively
    verify slug === to survive a Strapi that ignores the filter. */}
<script>
  (async () => {
    const sec = document.querySelector('[data-nf]');
    const fire404 = () => {
      if (typeof window !== 'undefined' && typeof window.plausible === 'function') {
        window.plausible('404', { props: { path: location.pathname } });
      }
    };
    if (!sec || sec.getAttribute('data-nf-state') !== 'checking') {
      fire404();
      return;
    }

    const url = sec.getAttribute('data-nf-url');
    const slug = sec.getAttribute('data-nf-slug');
    const prefix = sec.getAttribute('data-nf-prefix');

    let settled = false;
    const toDefault404 = () => {
      if (settled) return;
      settled = true;
      sec.setAttribute('data-nf-state', 'gone');
      fire404();
    };
    const toPublishing = () => {
      settled = true;
      sec.setAttribute('data-nf-state', 'publishing');
      document.title = 'Publishing… | ICJIA';
      if (typeof window.plausible === 'function') {
        window.plausible('404-publishing', { props: { path: location.pathname } });
      }
      const retry = document.getElementById('nf-retry');
      if (retry) retry.addEventListener('click', () => location.reload());
    };
    const timer = setTimeout(toDefault404, 6000);

    try {
      const rows = await fetch(url, { headers: { accept: 'application/json' } }).then((r) =>
        r.ok ? r.json() : [],
      );
      if (settled) return;
      const rec = Array.isArray(rows) ? rows.find((x) => x && x.slug === slug) : null;
      if (!rec) {
        clearTimeout(timer);
        toDefault404();
        return;
      }

      // Published but not yet built → render it live if we have a renderer.
      let preview = null;
      try {
        const mod = await import('../lib/live/detail-preview');
        preview = mod.renderDetail(prefix, rec);
      } catch (_e) {
        preview = null;
      }
      if (settled) return;
      clearTimeout(timer);

      if (preview) {
        settled = true;
        // Announce via a BODY-level polite region created BEFORE the swap —
        // sec.outerHTML replaces the 404's own aria-live regions, and replacing
        // a live region silences it; the title change alone is not announced.
        const status = document.createElement('div');
        status.className = 'sr-only';
        status.setAttribute('aria-live', 'polite');
        document.body.appendChild(status);
        sec.removeAttribute('data-nf-state');
        sec.outerHTML = preview.html;
        document.title = preview.title;
        // Client-side "navigation" completed → move focus to the rendered
        // content's first heading so SR/keyboard users land on the content.
        const h = document.querySelector('main h1, main h2');
        if (h) {
          h.setAttribute('tabindex', '-1');
          h.focus();
        }
        setTimeout(() => {
          status.textContent = 'Page loaded: ' + preview.title;
        }, 60);
        if (typeof window.plausible === 'function') {
          window.plausible('404-rendered', { props: { path: location.pathname } });
        }
      } else {
        toPublishing();
      }
    } catch (_e) {
      clearTimeout(timer);
      toDefault404();
    }
  })();
</script>

<style>
  .nf {
    background: #fff;
    padding: 56px 20px 72px;
  }
  .nf-inner {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }
  /* Decorative numeral — Oswald, navy→primary gradient. aria-hidden; the <h1>
     carries the announcement. Hidden in the checking/publishing states (it's not a
     "not found" there). */
  .nf-num {
    font-family: 'Oswald', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(96px, 22vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    background: linear-gradient(120deg, #0a3a60 0%, #1565c0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin: 0;
  }
  .nf-head {
    font-family: 'Oswald', system-ui, sans-serif;
    font-weight: 600;
    font-size: clamp(28px, 5vw, 40px);
    color: #0a3a60;
    margin: 8px 0 12px;
  }
  .nf-sub {
    font-size: 17px;
    line-height: 1.6;
    color: #444;
    max-width: 56ch;
    margin: 0 auto 28px;
  }

  /* ── state machine (404 hidden by default): the numeral + "not found" copy stay
     display:none until JS confirms a real miss ([data-nf-state='gone']). A detail-route
     candidate paints the neutral "checking" state — never "not found" — until the Strapi
     check resolves, so there is no "404 flash" independent of JS/paint timing. The
     <noscript> block above restores the 404 when JS is disabled. */
  .nf-num,
  .nf-msg--default,
  .nf-msg--checking,
  .nf-msg--publishing {
    display: none;
  }
  [data-nf-state='gone'] .nf-num,
  [data-nf-state='gone'] .nf-msg--default {
    display: block;
  }
  [data-nf-state='checking'] .nf-msg--checking,
  [data-nf-state='publishing'] .nf-msg--publishing {
    display: block;
  }
  .nf-retry-wrap {
    margin: 0 0 28px;
  }

  .nf-search {
    display: flex;
    gap: 8px;
    max-width: 520px;
    margin: 0 auto 40px;
  }
  .nf-search-input {
    flex: 1;
    height: 48px;
    padding: 0 16px;
    font-size: 16px;
    color: #222;
    background: #fff;
    border: 2px solid #cfd8e3;
    border-radius: 4px;
  }
  .nf-search-input:focus {
    outline: none;
    border-color: #1565c0;
    box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.2);
  }
  .nf-search-btn {
    height: 48px;
    padding: 0 24px;
    font-weight: 700;
    font-size: 16px;
    color: #fff;
    background: #1565c0;
    border: 2px solid #1565c0;
    border-radius: 4px;
    cursor: pointer;
  }
  .nf-search-btn:hover {
    background: #0a3a60;
    border-color: #0a3a60;
  }

  .nf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    text-align: left;
  }
  @media (min-width: 600px) {
    .nf-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .nf-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 12px 18px;
    background: #f6f8fa;
    border: 1px solid #e3e8ee;
    border-left: 4px solid #1565c0;
    border-radius: 4px;
    color: #0a3a60;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    transition:
      background 0.15s ease,
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .nf-card:hover {
    background: #eef3f9;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(10, 58, 96, 0.12);
  }
  .nf-card-arrow {
    font-size: 28px;
    line-height: 1;
    color: #1565c0;
  }

  .nf-help {
    margin: 36px 0 0;
    font-size: 15px;
    color: #555;
  }
  .nf-help a {
    color: #1565c0;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-card {
      transition: none;
    }
    .nf-card:hover {
      transform: none;
    }
  }
</style>

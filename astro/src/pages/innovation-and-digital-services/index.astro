---
// /innovation-and-digital-services/ — IDS overview. Ports ISUHome.vue: a plain
// CMS page (slug 'innovation-and-digital-services-home', title+body+showTOC+
// clickthrough), rendered by the shared BasePage. contextTitle "Home" (legacy
// EventBus context-label "Home").
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage } from '../../lib/data';

const page = await getPage('innovation-and-digital-services-home');
if (!page) return new Response(null, { status: 404 });
---

<BaseLayout
  title={page.title}
  description={page.summary || page.title}
  contextTitle="Home"
>
  <BasePage page={page} />
</BaseLayout>

---
// /innovation-and-digital-services/:slug — IDS sub-page catch-all. Ports the
// legacy IDSBasepage route (/innovation-and-digital-services/:slug -> BasePage.vue):
// a generic CMS page by slug (e.g. /innovation-and-digital-services/drone/),
// rendered by the shared BasePage. 404 when the slug has no page.
//
// Astro resolves the dedicated /infonet/ and /isu-staff/ index routes ahead of
// this dynamic segment, so this only handles the remaining sub-pages.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage, getAllPages } from '../../lib/data';

// Prerendered — builds the innovationAndDigitalServices-category CMS sub-pages
// (e.g. /drone/) minus the RESERVED slugs that have their own dedicated routes.
// Refreshed on nightly/manual rebuild.
export const prerender = true;
export async function getStaticPaths() {
  // Inlined RESERVED — getStaticPaths runs in its own prerender chunk. Dedicated
  // routes win over [slug]: /infonet/ + /isu-staff/ index pages, and the section
  // home slug owned by the /innovation-and-digital-services/ index route.
  const reserved = new Set([
    'infonet', 'isu-staff', 'innovation-and-digital-services-home',
  ]);
  const pages = await getAllPages();
  return pages
    .filter((p) => p.category === 'innovationAndDigitalServices' && p.slug && !reserved.has(p.slug))
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const page = slug ? await getPage(slug) : null;
if (!page) return new Response(null, { status: 404 });
---

<BaseLayout
  title={page.title}
  description={page.summary || page.title}
  contextTitle={page.title}
>
  <BasePage page={page} />
</BaseLayout>

---
// /news/ — live-data SSR. Parity with the legacy News.vue (featured + category
// filters + month-grouped + paginated); all logic lives in NewsListing.astro.
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsListing from '../../components/NewsListing.astro';
import { getAllNews } from '../../lib/data';
import { setCache } from '../../lib/cache';

const posts = await getAllNews();
setCache(Astro.response, 'news');
---

<BaseLayout
  title="News & Information"
  description="News, announcements, and updates from the Illinois Criminal Justice Information Authority."
>
  <div class="mx-auto max-w-[900px] lg:max-w-[1185px] xl:max-w-[1785px] px-4 py-8 md:px-6">
    {
      posts.length === 0 ? (
        <p>No news at this time.</p>
      ) : (
        <NewsListing items={posts} />
      )
    }
  </div>
</BaseLayout>

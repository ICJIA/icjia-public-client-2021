---
// /news/publications/ — identical listing to /about/publications/. Legacy maps
// this route to the SAME PublicationsAll.vue (no heading/content variant), so
// this is a thin page rendering the shared PublicationsListing component. Both
// ship the recent ~150 (PublicationTable lazy-loads the full archive from
// /api/publications.json after paint — see /about/publications/).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicationsListing from '../../../components/PublicationsListing.astro';
import { getPublicationsRecent } from '../../../lib/data';

// Prerendered (renderStrategy: static) — same as /about/publications/ (build-time, nightly
// refresh; recent ~150 baked + the static /api/publications.json lazy-loaded for search/sort).
export const prerender = true;

const publications = await getPublicationsRecent(150);
---

<BaseLayout
  title="Publications"
  description="Research reports, bulletins, datasets, and other publications from the Illinois Criminal Justice Information Authority."
  contextTitle="Publications"
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    {
      publications.length === 0 ? (
        <p>No publications at this time.</p>
      ) : (
        <PublicationsListing publications={publications} />
      )
    }
  </div>
</BaseLayout>

---
// /news/meetings/[slug] — live-data SSR single meeting. Parity with the legacy
// MeetingsSingle.vue: "ICJIA Meetings" heading, the full MeetingCard, a "View all
// meetings »" link, and the JSON-LD Event (ported from metaInfo).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MeetingCard from '../../../components/MeetingCard.astro';
import { getMeeting } from '../../../lib/data';
import { setCache } from '../../../lib/cache';
import { buildEventJsonLd } from '../../../lib/seo';

const { slug } = Astro.params;
const meeting = slug ? await getMeeting(slug) : null;

if (!meeting) {
  return new Response('Not found', { status: 404 });
}

setCache(Astro.response, 'meetings');

// Rich Event JSON-LD inputs (faithful to the legacy MeetingsSingle metaInfo):
// the external link → VirtualLocation, and attachments (agenda/minutes) →
// associatedMedia. Strapi `url`s may be relative (/uploads/…) → absolutize.
const STRAPI_BASE = 'https://agency.icjia-api.cloud';
const EXT_TO_MIME: Record<string, string> = {
  pdf: 'application/pdf',
  doc: 'application/msword',
  docx: 'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
  xls: 'application/vnd.ms-excel',
  xlsx: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
  csv: 'text/csv',
  txt: 'text/plain',
  zip: 'application/zip',
};
const absStrapi = (u?: string): string | null => {
  if (typeof u !== 'string' || !u) return null;
  const t = u.trim();
  if (/^https?:\/\//.test(t)) return t;
  if (t.startsWith('/')) return `${STRAPI_BASE}${t}`;
  return null;
};
const firstExternal = meeting.external.find((e) => absStrapi(e.url));
const virtualLocation = firstExternal
  ? { url: absStrapi(firstExternal.url)!, name: firstExternal.title || undefined }
  : undefined;
const attachments = meeting.attachments
  .map((a) => {
    const url = absStrapi(a.url);
    return url && a.name ? { name: a.name, url, encodingFormat: EXT_TO_MIME[a.ext] || a.ext } : null;
  })
  .filter((x): x is { name: string; url: string; encodingFormat: string } => x !== null);

const jsonLd = buildEventJsonLd({
  path: Astro.url.pathname,
  name: meeting.title,
  description: meeting.summary,
  startDate: meeting.start,
  endDate: meeting.end,
  cancelled: meeting.isCancelled,
  virtualLocation,
  attachments,
});
---

<BaseLayout title={meeting.title} description={meeting.summary} contextTitle={meeting.title} jsonLd={jsonLd}>
  <div class="meetings mx-auto max-w-4xl px-4 py-8 md:px-6">
    <div class="page-heading">
      <h1>ICJIA Meetings</h1>
    </div>
    <MeetingCard item={meeting} />
    <div class="mt-5 text-right">
      <a class="view-all" href="/news/meetings/">View all meetings&nbsp;&raquo;</a>
    </div>
  </div>
</BaseLayout>

---
// /search/<query>/ — the deep-link target for site search (tag, author and unit
// links across the site, as the live site's /search/:query). The same page as
// /search/ (src/components/SearchIsland.astro), with the search taken from the
// address.
//
// On-demand SSR (prerender = false), NOT prerendered: search queries are
// unbounded, and only an on-demand route makes Astro.params.query carry an
// arbitrary value. The shell does NO Strapi fetch.
//
// noindex: a search UI / query-result page isn't durable content (checklist rule).
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchIsland from '../../components/SearchIsland.astro';

let initialQuery = '';
try {
  initialQuery = decodeURIComponent(Astro.params.query ?? '');
} catch {
  initialQuery = Astro.params.query ?? '';
}
---

<BaseLayout
  title="Search"
  description="Search the Illinois Criminal Justice Information Authority (ICJIA) — news, public meetings, funding, publications, research articles, datasets, and staff."
  contextTitle="Search"
  noindex
>
  <SearchIsland initialQuery={initialQuery} />
</BaseLayout>

---
// /search/ — the site search (v1.5.146): the live site's search page, in
// src/components/SearchIsland.astro, run by src/scripts/search/page.js (a Web
// Worker, public/searchWorker.js, loads /searchIndex.json and runs Fuse off the
// main thread). The chrome's search icon, the footer and the 404 form hand off
// here; a typed search is written into the address as /search/?q=…&filter=….
//
// noindex: a search UI / query-result page isn't durable content (checklist rule).
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SearchIsland from '../components/SearchIsland.astro';
---

<BaseLayout
  title="Search"
  description="Search the Illinois Criminal Justice Information Authority (ICJIA) — news, public meetings, funding, publications, research articles, datasets, and staff."
  contextTitle="Search"
  noindex
>
  <SearchIsland />
</BaseLayout>

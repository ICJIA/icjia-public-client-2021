---
// /researchhub/apps/ — all published web apps, live (HUB Strapi). Parity with
// AppsAll.vue: grid/list ?view toggle, NO pagination (render all), base64 image
// (served via the JSON island as a lazy <img>, never inlined into bulk SSR HTML).
// Heading is "Web Applications", count noun is "web apps".
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HubListing from '../../../components/researchhub/HubListing.astro';
import { getAllApps } from '../../../lib/research';

const apps = await getAllApps();
---

<BaseLayout
  title="Web Applications"
  description="Interactive criminal justice web applications from the Illinois Criminal Justice Information Authority."
  contextTitle="Web Applications"
>
  <div class="mx-auto max-w-[900px] lg:max-w-[1185px] xl:max-w-[1785px] px-4 py-8 md:px-6">
    {
      apps.length === 0 ? (
        <p>No web applications at this time.</p>
      ) : (
        <HubListing kind="apps" heading="Web Applications" noun="web apps" items={apps} showUpdated />
      )
    }
  </div>
</BaseLayout>

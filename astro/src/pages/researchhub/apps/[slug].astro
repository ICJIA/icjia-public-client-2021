---
// /researchhub/apps/[slug] — single web app (live, HUB Strapi). getApp returns
// null when no published app matches → 404. Context bar = app title.
// NOTE: hub single-record queries inline the sanitized slug literal (graphql/hub.js) —
// this Strapi v3 hub ignores `where` variables. Distinct slugs resolve correctly.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AppView from '../../../components/researchhub/AppView.astro';
import { getApp, getAllApps } from '../../../lib/research';
import { buildAppJsonLd } from '../../../lib/seo';

export const prerender = true;
export async function getStaticPaths() {
  const items = await getAllApps();
  return items.filter((a) => a.slug).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const app = slug ? await getApp(slug) : null;
if (!app) {
  return new Response('App not found', { status: 404 });
}

const jsonLd = buildAppJsonLd({
  path: Astro.url.pathname,
  name: app.title,
  description: app.description,
  appUrl: app.url,
});
---

<BaseLayout
  title={app.title}
  description={app.description ? app.description.slice(0, 200) : undefined}
  contextTitle={app.title}
  jsonLd={jsonLd}
>
  <div class="pt-4">
    <AppView app={app} />
  </div>
</BaseLayout>

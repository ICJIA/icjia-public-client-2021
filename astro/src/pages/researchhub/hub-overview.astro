---
// /researchhub/hub-overview/ — generic CMS page (BasePage), AGENCY Strapi page
// slug "hub-overview". Returns null → 404 when the page is absent.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage } from '../../lib/data';
import { setCache } from '../../lib/cache';

const page = await getPage('hub-overview');
if (!page) {
  return new Response('Page not found', { status: 404 });
}
setCache(Astro.response, 'page');
---

<BaseLayout
  title={page.title}
  description={page.summary || undefined}
  contextTitle={page.title}
>
  <BasePage page={page} />
</BaseLayout>

---
// /researchhub/articles/[slug] — single article (live, HUB Strapi). getArticle
// returns null when no published article matches → 404. Context bar shows the
// article title.
//
// NOTE: hub single-record queries inline the SANITIZED slug literal (graphql/hub.js),
// because this Strapi v3 hub ignores `where` passed as a GraphQL variable (returns all
// rows). Verified on the deploy: distinct slugs resolve to distinct articles.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleView from '../../../components/researchhub/ArticleView.astro';
import { getArticle, getAllArticles } from '../../../lib/research';

export const prerender = true;
export async function getStaticPaths() {
  const items = await getAllArticles();
  return items.filter((a) => a.slug).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = slug ? await getArticle(slug) : null;
if (!article) {
  return new Response('Article not found', { status: 404 });
}
// NOTE: the ScholarlyArticle JSON-LD (with real author names) is emitted by the
// <ArticleView> component itself — do NOT add a page-level block here (it would
// duplicate). See src/components/researchhub/ArticleView.astro.
---

<BaseLayout
  title={article.title}
  description={article.abstract ? article.abstract.replace(/<[^>]+>/g, '').slice(0, 200) : undefined}
  contextTitle={article.title}
>
  <div class="pt-2 pb-12">
    <ArticleView article={article} />
  </div>
</BaseLayout>

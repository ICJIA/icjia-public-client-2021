---
// /grants/<slug>/ — generic CMS-page catch-all (ports legacy BasePage.vue, the
// /grants/:slug route). Covers training, technical-assistance, required-forms,
// funded-programs-map, and any future single CMS page in the grants section:
// fetch GET_SINGLE_PAGE_QUERY by slug -> getPage(); 404 when no page.
//
// Renders optional Splash, h1, body HTML, tag chips, AttachmentList, showTOC
// sidebar, and clickthrough boxes — all via the shared BasePage.astro renderer.
// contextTitle = page.title (legacy BasePage emits the CMS title).
//
// EXCLUDED slugs (own dedicated, non-BasePage views) + 'policies' (an about-category
// CMS page with an empty body that must NOT render here — /grants/policies/ 301s to
// rules-regs-policies via _redirects; this is the belt to that suspenders):
//   - funding, programs, fsgu-home, fsgu-staff, rules-regs-policies, policies
// In Astro, dedicated route files win over [slug]; this denylist is the belt to
// that suspenders, so we never render another section's data through BasePage.
//
// NOTE (search unported): tag chips render as plain <span class="chip"> (in
// BasePage.astro), not links to /search/:tag — the Search section is not built
// yet. To be restored when Search lands.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage } from '../../lib/data';
import { setCache } from '../../lib/cache';

const RESERVED = new Set([
  'funding',
  'programs',
  'fsgu-home',
  'fsgu-staff',
  'rules-regs-policies',
  'policies',
]);

const { slug } = Astro.params;

if (!slug || RESERVED.has(slug)) {
  return new Response('Not found', { status: 404 });
}

const page = await getPage(slug);

if (!page) {
  return new Response('Not found', { status: 404 });
}

setCache(Astro.response, 'page');
---

<BaseLayout
  title={page.title || 'ICJIA'}
  description={page.summary}
  contextTitle={page.title}
>
  <BasePage page={page} />
</BaseLayout>

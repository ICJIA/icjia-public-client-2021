---
// /irb/<slug>/ — IRB-category CMS pages (irb-members-and-staff, irb-policies-and-procedures,
// irb-other-resources, + irb-home which also renders at /irb/). Ports the legacy /irb/:slug
// (BasePage.vue). Prerendered (renderStrategy: static — IRB content is stable); getStaticPaths
// enumerates the irb-category pages. The /irb/ context bar auto-renders.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage, getAllPages } from '../../lib/data';

export const prerender = true;
export async function getStaticPaths() {
  // irb-meetings is a dedicated meetings VIEW (its own route), not a CMS page — excluded.
  const reserved = new Set(['irb-meetings']);
  const pages = await getAllPages();
  return pages
    .filter((p) => p.category === 'irb' && p.slug && !reserved.has(p.slug))
    .map((p) => ({ params: { slug: p.slug } }));
}

const RESERVED = new Set(['irb-meetings']);
const { slug } = Astro.params;
if (!slug || RESERVED.has(slug)) {
  return new Response('Not found', { status: 404 });
}
const page = await getPage(slug);
if (!page) {
  return new Response('Not found', { status: 404 });
}
---

<BaseLayout title={page.title || 'ICJIA'} description={page.summary} contextTitle={page.title}>
  <BasePage page={page} />
</BaseLayout>

---
// /irb/irb-meetings/ — IRB meetings listing. Ports legacy IRBMeetings.vue
// (GET_MEETINGS_BY_CATEGORY_QUERY category:"irb" → MeetingTable). LIVE SSR (meetings
// change). Ships ONLY the irb meetings in the shared #meetings-data island; MeetingTable
// reads it (search / sort / paginate + lazy per-row detail via /api/meeting.json). The
// /irb/ context bar auto-renders (contextMenus.json /irb/ menu).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MeetingTable from '../../../components/MeetingTable.astro';
import { getAllMeetings } from '../../../lib/data';
import { buildProbe } from '../../../lib/live/probe';
import '../../../styles/meetings.css';

const meetings = (await getAllMeetings()).filter((m) => m.category === 'irb');

// JSON-in-HTML: neutralize "<" so the data island can't break out of the script.
const listJson = JSON.stringify(meetings).replace(/</g, '\\u003c');
const baseline = meetings.slice(0, 25);

// Collection-level freshness probe (same one the shared meetings island bakes).
const liveProbe = await buildProbe('meetings');
const liveProbeAttr = liveProbe ? JSON.stringify(liveProbe) : undefined;
---

<BaseLayout
  title="IRB Meetings"
  description="Meetings of the ICJIA Institutional Review Board (IRB)."
  contextTitle="Meetings"
>
  <div class="meetings mx-auto max-w-[900px] lg:max-w-[1185px] xl:max-w-[1785px] px-4 py-8 md:px-6">
    <div class="page-heading mb-6">
      <h1>IRB Meetings</h1>
    </div>
    {
      meetings.length === 0 ? (
        <p>No IRB meetings at this time.</p>
      ) : (
        <>
          <script type="application/json" id="meetings-data" set:html={listJson} data-live-probe={liveProbeAttr}></script>
          {/* category="irb": the island ships irb-only rows, so the LIVE swap must
              filter too — without it the swap replaced this table with ALL meetings. */}
          <MeetingTable category="irb" baseline={baseline} />
        </>
      )
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeSplash from '../components/HomeSplash.astro';
import WidgetBar from '../components/WidgetBar.astro';
import HomeCardNews from '../components/HomeCardNews.astro';
import HomeTabbed from '../components/HomeTabbed.astro';
import HomeClickThroughBoxes from '../components/HomeClickThroughBoxes.astro';
import HomeResearch from '../components/HomeResearch.astro';
import { getHome } from '../lib/data';
import { setCache } from '../lib/cache';
import { buildHomeJsonLd } from '../lib/seo';

const home = await getHome();
// Tag home with every live section it surfaces so a publish in ANY of them purges
// the landing page too (purge-on-publish — netlify/functions/purge-cache.mjs).
setCache(Astro.response, 'home', ['news', 'hub', 'grants', 'events', 'jobs', 'meetings', 'bios']);

const newsMenuItems = [
  { label: 'News', url: '/news/' },
  { label: 'Meetings', url: '/news/meetings/' },
  { label: 'Funding', url: '/grants/funding/' },
  { label: 'Employment', url: '/about/employment/' },
  { label: 'Events', url: '/news/events/' },
];
---

<BaseLayout
  title="Illinois Criminal Justice Information Authority"
  description="ICJIA is an Illinois state agency improving criminal justice through research, grants, and policy development."
  jsonLd={buildHomeJsonLd()}
>
  <HomeSplash />

  <div class="bg-white" style="margin-top: -20px; position: relative; z-index: 1">
    <WidgetBar title="News & Information" mobileTitle="News" menuItems={newsMenuItems} />
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="pt-[15px] md:border-r md:border-[#e8e8e8]">
        {home.news.map((item, i) => <HomeCardNews item={item} index={i} />)}
      </div>
      <div>
        <HomeTabbed
          grants={home.funding}
          meetings={home.meetings}
          employment={home.employment}
        />
      </div>
    </div>
  </div>

  <div class="my-5"></div>
  <HomeClickThroughBoxes boxes={home.boxes.slice(0, 3)} />

  {/* No negative top margin: the prior -20px pulled this bar up into the boxes
      above, overlapping the "Technical Assistance" box link with the
      "Research Hub" link (a11y target-size fail). Exact gap is VR-tune territory. */}
  <div class="mt-2">
    <HomeResearch />
  </div>
</BaseLayout>

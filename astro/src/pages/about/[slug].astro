---
// /about/[slug]/ — generic CMS-page catch-all (ports legacy BasePage.vue, the
// /about/:slug route in src/router/about/index.js). Covers icjia-values,
// icjia-committees, dicra, foia, contact, covid-19, and any future single CMS
// page: fetch GET_SINGLE_PAGE_QUERY by slug -> getPage(); 404 when no page.
//
// Renders optional Splash, h1, body HTML, tag chips, AttachmentList, showTOC
// sidebar, and clickthrough boxes — all via the shared BasePage.astro renderer.
// contextTitle = page.title (legacy BasePage emits the CMS title, unlike
// AboutHome which forces "About").
//
// EXCLUDED slugs (own dedicated, non-BasePage views; other migration agents):
//   - composition-and-membership, icjia-staff, biographies  (Bios/Staff scope:
//       fetch GET_ALL_BIOGRAPHIES_QUERY/UNITS + BiographyCard, not a CMS page)
//   - employment            (EmploymentAll.vue — own query/list view)
//   - publications          (PublicationsAll.vue — own query/list view)
//   - units                 (legacy only has /about/units/:slug; bare "units"
//                             is not a CMS page)
// In Astro, dedicated route files win over [slug]; this denylist is the belt to
// that suspenders, so we never render another section's data through BasePage.
//
// NOTE: tag chips (rendered in BasePage.astro) link to /search/?q=<tag>, which
// autofills the search box with the tag and shows related results.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BasePage from '../../components/BasePage.astro';
import { getPage, getAllPages } from '../../lib/data';

// Prerendered (renderStrategy: about) — builds the about-category CMS pages minus the
// RESERVED dedicated-route slugs below. Refreshed on nightly/manual rebuild.
export const prerender = true;

const RESERVED = new Set([
  'composition-and-membership',
  'icjia-staff',
  'biographies',
  'employment',
  'publications',
  'units',
]);

export async function getStaticPaths() {
  // Local copy of RESERVED — getStaticPaths runs in its own prerender chunk and
  // cannot see the module-level RESERVED const below; keep the two in sync.
  const reserved = new Set([
    'composition-and-membership', 'icjia-staff', 'biographies', 'employment', 'publications', 'units',
  ]);
  const pages = await getAllPages();
  return pages
    // DICRA is researchhub-category, but prod's About-menu context bar links it at
    // /about/dicra/ ("Death in Custody Reporting"), so serve it here to keep the ported
    // contextMenus.json faithful + that tab working (/researchhub/dicra/ 301s here).
    .filter((p) => (p.category === 'about' || p.slug === 'dicra') && p.slug && !reserved.has(p.slug))
    .map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;

if (!slug || RESERVED.has(slug)) {
  return new Response('Not found', { status: 404 });
}

const page = await getPage(slug);

if (!page) {
  return new Response('Not found', { status: 404 });
}
---

<BaseLayout
  title={page.title || 'ICJIA'}
  description={page.summary}
  contextTitle={page.title}
>
  <BasePage page={page} />
</BaseLayout>

---
// /about/employment/[slug] — live-data SSR single job. Parity with EmploymentSingle.vue:
// a visually-hidden H1 (job title) + the full JobCard (summaryOnly=false) wrapped in
// a centered container. 404 Response when the slug isn't found.
//
// A11y structure preserved from legacy: one sr-only <h1> + the JobCard <h2> title
// (here non-linking, since on its own page the title links to itself in the list only).
// context-label = "Employment at ICJIA" (legacy EmploymentSingle EventBus emit).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JobCard from '../../../components/JobCard.astro';
import { getJob, getAllJobs } from '../../../lib/data';
import { buildJobPostingJsonLd } from '../../../lib/seo';

export const prerender = true;
export async function getStaticPaths() {
  const items = await getAllJobs();
  return items.filter((j) => j.slug).map((j) => ({ params: { slug: j.slug } }));
}

const { slug } = Astro.params;
const job = slug ? await getJob(slug) : null;

if (!job) {
  return new Response('Not found', { status: 404 });
}


// Meta description: plain-text job summary (tags stripped), with a generic fallback.
const metaDescription =
  (job.summaryHtml || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() ||
  `Employment opportunity at the Illinois Criminal Justice Information Authority (ICJIA): ${job.title}.`;

const jsonLd = buildJobPostingJsonLd({
  path: Astro.url.pathname,
  title: job.title,
  description: job.summaryHtml,
  datePosted: job.start,
  validThrough: job.end,
});
---

<BaseLayout title={job.title} description={metaDescription} contextTitle="Employment at ICJIA" jsonLd={jsonLd}>
  <div class="employment markdown-body mx-auto max-w-4xl px-4 py-8 md:px-6">
    <h1 class="sr-only">{job.title}</h1>
    <JobCard item={job} summaryOnly={false} />
  </div>
</BaseLayout>

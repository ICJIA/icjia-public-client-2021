---
// /about/publications/ — canonical Publications listing. Live-data SSR; all
// logic lives in PublicationsListing.astro + PublicationTable.astro. PERF: the SSR
// ships only the RECENT ~150 rows (light doc → fast FCP/LCP); PublicationTable
// lazy-loads the full ~1108-row archive from /api/publications.json after first paint
// for whole-archive search/sort. /news/publications/ renders the SAME component.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicationsListing from '../../../components/PublicationsListing.astro';
import { getPublicationsRecent } from '../../../lib/data';
import { setCache } from '../../../lib/cache';

const publications = await getPublicationsRecent(150);
setCache(Astro.response, 'publications');
---

<BaseLayout
  title="Publications"
  description="Research reports, bulletins, datasets, and other publications from the Illinois Criminal Justice Information Authority."
  contextTitle="Publications"
>
  <div class="mx-auto max-w-6xl px-4 py-8 md:px-6">
    {
      publications.length === 0 ? (
        <p>No publications at this time.</p>
      ) : (
        <PublicationsListing publications={publications} />
      )
    }
  </div>
</BaseLayout>

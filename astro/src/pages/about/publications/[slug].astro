---
// /about/publications/[slug] — live-data SSR single publication. Parity with the
// legacy PublicationsSingle.vue: an sr-only h1 (the title), the standalone
// PublicationCard, and a "View all publications »" link. Sourced via GraphQL
// singlePub(where:{slug}) (one row — GraphQL is fine here, unlike the list);
// getPublication returns null when the slug is unknown → 404 (legacy pushed /404).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicationCard from '../../../components/PublicationCard.astro';
import { getPublication, getAllPublicationSlugs } from '../../../lib/data';
import { buildArticleJsonLd } from '../../../lib/seo';
import '../../../styles/publications.css';

export const prerender = true;
export async function getStaticPaths() {
  // getAllPublications() island-trims the slug out, so use the slug-preserving fetcher
  // (else ZERO detail pages build and every /about/publications/<slug>/ 404s).
  const slugs = await getAllPublicationSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const publication = slug ? await getPublication(slug) : null;

if (!publication) {
  return new Response('Not found', { status: 404 });
}


const jsonLd = buildArticleJsonLd({
  type: 'Report',
  path: Astro.url.pathname,
  headline: publication.title,
  description: publication.summary,
  datePublished: publication.publicationDate,
});
---

<BaseLayout
  title={publication.title}
  description={publication.summary}
  contextTitle={publication.title}
  jsonLd={jsonLd}
>
  <div class="publications markdown-body mx-auto max-w-4xl px-4 py-8 md:px-6">
    <h1 class="sr-only">{publication.title}</h1>
    <PublicationCard item={publication} />
    <div class="mt-5 text-right">
      <a class="view-all" href="/about/publications/">View all publications&nbsp;&raquo;</a>
    </div>
  </div>
</BaseLayout>

VUE_APP_THUMBOR_KEY=
PLAUSIBLE_API_KEY=
PLAUSIBLE_API_DOMAIN=icjia.illinois.gov
PLAUSIBLE_API_BASE=hhttps://plausible.icjia.cloud/

# ─────────────────────────────────────────────────────────────────────────────
# Netlify usage monitor (scripts/netlify-usage-monitor.mjs)
#
# Copy this file to .env (gitignored) and fill in real values. These are ONLY for
# running the monitor LOCALLY:
#     node --env-file=.env scripts/netlify-usage-monitor.mjs
#
# In production the monitor runs in GitHub Actions, which reads the SAME names
# from GitHub repo SECRETS (Settings → Secrets and variables → Actions) — NOT from
# this file. ⚠️ None of these go in Netlify env vars — the monitor does not run on
# Netlify. (Only the optional keep-warm kill switch KEEP_WARM_DISABLED=1 is set in
# the Netlify UI.)
# ─────────────────────────────────────────────────────────────────────────────

# Netlify read-only usage query
NETLIFY_AUTH_TOKEN=
NETLIFY_TEAM_SLUG=

# Mailgun email delivery
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us

# Email routing (ALERT_EMAIL_FROM optional → defaults to monitor@MAILGUN_DOMAIN)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Monitor tuning (optional)
ALERT_MODE=digest-and-alerts
WARN_PCT=70
CRIT_PCT=90

# ─────────────────────────────────────────────────────────────────────────────
# Netlify-side env vars (set in the Netlify UI, NOT here — the app/functions run
# on Netlify, not from this .env):
#   NETLIFY_BUILD_HOOK_URL=...   # build-hook URL the nightly rebuild POSTs (REQUIRED
#                                #   for the nightly rebuild — see docs/nightly-rebuild.md)
#   KEEP_WARM_DISABLED=1         # instantly disable the keep-warm ping (no redeploy)
#   NIGHTLY_REBUILD_DISABLED=1   # instantly disable the nightly rebuild (no redeploy)
# ─────────────────────────────────────────────────────────────────────────────